<% overdue = task.due_date.present? &&
             task.due_date < Date.current &&
             !task.completed? %>

<article
  id="<%= dom_id(task) %>"
  class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm"
>
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-semibold text-gray-900">
          <%= task.title %>
        </h3>

        <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
          <%= task.status.titleize %>
        </span>

        <span class="inline-flex rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">
          <%= task.priority.titleize %> priority
        </span>

        <% if overdue %>
          <span class="inline-flex rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">
            Overdue
          </span>
        <% end %>
      </div>

      <p class="mt-2 text-sm text-gray-500">
        <% if task.due_date.present? %>
          Due <%= task.due_date.strftime("%B %-d, %Y") %>
        <% else %>
          No due date
        <% end %>
      </p>
    </div>

    <%= link_to "Delete",
                client_task_path(client, task),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this task?"
                },
                class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
  </div>

  <% if task.description.present? %>
    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= task.description %>
    </div>
  <% end %>

  <div class="mt-5 flex flex-wrap gap-2">
    <% unless task.pending? %>
      <%= button_to "Mark pending",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "pending"
                      }
                    },
                    class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>
    <% end %>

    <% unless task.in_progress? %>
      <%= button_to "Start task",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "in_progress"
                      }
                    },
                    class: "rounded-lg border border-indigo-300 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-50" %>
    <% end %>

    <% unless task.completed? %>
      <%= button_to "Complete task",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "completed"
                      }
                    },
                    class: "rounded-lg bg-green-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-green-700" %>
    <% end %>
  </div>
</article>