<% overdue = task.due_date.present? &&
             task.due_date < Date.current &&
             !task.completed? %>

<% priority_classes =
     case task.priority
     when "high"
       "bg-[#f3e3e0] text-[#9d443d]"
     when "low"
       "bg-[#e5eee8] text-[#3e7157]"
     else
       "bg-[#f5ead7] text-[#9b661f]"
     end %>

<% status_classes =
     case task.status
     when "completed"
       "bg-[#e2ece5] text-[#39634c]"
     when "in_progress"
       "bg-[#e3eaf2] text-[#355e89]"
     else
       "bg-[#ecebea] text-[#53606b]"
     end %>

<article
  id="<%= dom_id(task) %>"
  class="rounded-2xl border border-white/80 bg-white/65 p-5 shadow-[0_12px_35px_rgba(39,48,58,0.05)] backdrop-blur"
>
  <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div class="min-w-0">
      <div class="flex flex-wrap items-center gap-2">
        <h3 class="font-semibold text-[#17212a]">
          <%= task.title %>
        </h3>

        <span class="inline-flex rounded-lg px-2.5 py-1 text-xs font-medium <%= status_classes %>">
          <%= task.status.humanize %>
        </span>

        <span class="inline-flex rounded-lg px-2.5 py-1 text-xs font-medium <%= priority_classes %>">
          <%= task.priority.humanize %>
        </span>

        <% if overdue %>
          <span class="inline-flex rounded-lg bg-[#f3e3e0] px-2.5 py-1 text-xs font-medium text-[#9d443d]">
            Overdue
          </span>
        <% end %>
      </div>

      <div class="mt-3 flex flex-wrap gap-x-5 gap-y-2 text-sm text-[#68747e]">
        <p>
          Due
          <span class="font-medium text-[#3d4954]">
            <%= task.due_date.strftime("%b %-d, %Y") %>
          </span>
        </p>

        <p>
          <% if task.assigned_user.present? %>
            Assigned to
            <span class="font-medium text-[#3d4954]">
              <%= task.assigned_user.full_name %>
            </span>
          <% else %>
            Unassigned
          <% end %>
        </p>
      </div>
    </div>

    <%= link_to "Delete",
                client_task_path(client, task),
                data: {
                  turbo_method: :delete,
                  turbo_confirm: "Are you sure you want to delete this task?"
                },
                class: "text-sm font-medium text-[#8a4b46] transition hover:text-[#693733]" %>
  </div>

  <% if task.description.present? %>
    <p class="mt-4 whitespace-pre-wrap text-sm leading-6 text-[#586570]">
      <%= task.description %>
    </p>
  <% end %>

  <div class="mt-5 flex flex-wrap gap-2 border-t border-[#e3e3e1] pt-4">
    <% unless task.pending? %>
      <%= button_to "Mark pending",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "pending"
                      }
                    },
                    class: "rounded-lg border border-[#d5d5d2] bg-white/60 px-3 py-2 text-xs font-medium text-[#4f5c67] transition hover:bg-white" %>
    <% end %>

    <% unless task.in_progress? %>
      <%= button_to "Start task",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "in_progress"
                      }
                    },
                    class: "rounded-lg border border-[#cbd5df] bg-[#e8edf3] px-3 py-2 text-xs font-medium text-[#3e5f7d] transition hover:bg-[#dfe7ef]" %>
    <% end %>

    <% unless task.completed? %>
      <%= button_to "Complete task",
                    client_task_path(client, task),
                    method: :patch,
                    params: {
                      task: {
                        status: "completed"
                      }
                    },
                    class: "rounded-lg border border-[#cad9ce] bg-[#e7eee9] px-3 py-2 text-xs font-medium text-[#416550] transition hover:bg-[#dfe9e2]" %>
    <% end %>
  </div>
</article>