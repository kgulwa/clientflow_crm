<!DOCTYPE html>
<html>
  <head>
    <title>ClientFlow CRM</title>

    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    >

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind",
                            "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#eef0f3] text-[#18202a] antialiased">
    <% if user_signed_in? %>
      <div class="relative min-h-screen overflow-hidden lg:flex">
        <div
          aria-hidden="true"
          class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-[#eceff3] via-[#f6f1ec] to-[#dce4ef]"
        ></div>

        <div
          aria-hidden="true"
          class="pointer-events-none fixed -bottom-48 left-32 -z-10 h-[34rem] w-[70rem] rounded-[50%] bg-gradient-to-r from-[#d8dee8]/80 via-[#c9d4e4]/70 to-[#eadfd5]/60 blur-3xl"
        ></div>

        <div
          aria-hidden="true"
          class="pointer-events-none fixed -right-36 -top-44 -z-10 h-[32rem] w-[32rem] rounded-full bg-[#efe0d4]/50 blur-3xl"
        ></div>

        <aside class="relative z-20 flex border-b border-white/10 bg-[#17212a] text-white shadow-2xl shadow-slate-950/10 lg:fixed lg:inset-y-0 lg:left-0 lg:w-60 lg:flex-col lg:border-b-0">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-20 -left-24 h-72 w-72 rounded-full bg-[#b99c78]/15 blur-3xl"
          ></div>

          <div class="relative flex w-full items-center justify-between px-6 py-6 lg:block">
            <%= link_to root_path,
                        class: "flex items-center gap-3" do %>
              <div class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#d6c3aa] text-[#d6c3aa]">
                <span class="text-sm font-bold">C</span>
              </div>

              <span class="text-xl font-semibold tracking-[-0.02em] text-white">
                ClientFlow
              </span>
            <% end %>
          </div>

          <nav class="relative flex flex-1 gap-1 overflow-x-auto px-4 pb-5 lg:block lg:space-y-1 lg:overflow-visible">
            <%= link_to root_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{current_page?(root_path) ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-8.5Z" />
              </svg>

              Dashboard
            <% end %>

            <%= link_to clients_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/clients") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 0 1 0 7.75" />
              </svg>

              Clients
            <% end %>

            <%= link_to leads_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/leads") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3ZM9 12l2 2 4-4" />
              </svg>

              Leads
            <% end %>

            <%= link_to deals_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/deals") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16v13H4V7Zm4 0V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M4 12h16" />
              </svg>

              Deals
            <% end %>

            <%= link_to tasks_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/tasks") ? "bg-white/10 text-white shadow-sm" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.2 2.2 4.8-5" />
              </svg>

              Tasks
            <% end %>

            <%= link_to reports_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/reports") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
              </svg>

              Reports
            <% end %>

            <% if current_user.admin? %>
              <%= link_to workspace_invitations_path,
                          class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/workspace_invitations") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6" />
                </svg>

                Team
              <% end %>
            <% end %>
          </nav>

          <div class="relative hidden p-4 lg:block">
            <div class="rounded-2xl border border-white/[0.07] bg-white/[0.04] p-3.5">
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-white">
                  <%= avatar_initials(current_user.full_name) %>
                </div>

                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-white">
                    <%= current_user.full_name %>
                  </p>

                  <p class="mt-0.5 text-xs text-slate-400">
                    <%= current_user.role.titleize %>
                  </p>
                </div>

                <span class="text-slate-500">⌄</span>
              </div>
            </div>
          </div>
        </aside>

        <div class="relative z-10 flex min-h-screen min-w-0 flex-1 flex-col lg:ml-60">
          <header class="border-b border-[#d8d9dc]/80 bg-white/35 backdrop-blur-xl">
            <div class="flex min-h-[88px] items-center justify-between gap-4 px-6 lg:px-10">
              <div>
                <p class="text-xl font-semibold tracking-[-0.02em] text-[#17212a]">
                  <%= content_for?(:page_title) ? yield(:page_title) : "ClientFlow" %>
                </p>
              </div>

              <div class="flex items-center gap-3">
                <%= link_to destroy_user_session_path,
                            data: {
                              turbo_method: :delete
                            },
                            class: "rounded-xl border border-[#d6d3cf] bg-white/55 px-4 py-2.5 text-sm font-medium text-[#35414d] transition hover:bg-white" do %>
                  Sign out
                <% end %>
              </div>
            </div>
          </header>

          <% if notice.present? %>
            <div
              data-turbo-temporary
              class="mx-6 mt-5 flex items-center gap-3 rounded-xl border border-[#cfdccf] bg-[#eef4ed]/90 px-4 py-3 text-sm text-[#315542] shadow-sm lg:mx-10"
              role="alert"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#dce8dc] text-xs font-bold">
                ✓
              </span>

              <%= notice %>
            </div>
          <% end %>

          <% if alert.present? %>
            <div
              data-turbo-temporary
              class="mx-6 mt-5 flex items-center gap-3 rounded-xl border border-[#ead1ce] bg-[#f8efed]/90 px-4 py-3 text-sm text-[#834840] shadow-sm lg:mx-10"
              role="alert"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#f0ddda] text-xs font-bold">
                !
              </span>

              <%= alert %>
            </div>
          <% end %>

          <main class="flex-1 px-5 py-7 sm:px-6 lg:px-8 xl:px-10">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="min-h-screen lg:grid lg:grid-cols-2">
        <section class="relative hidden overflow-hidden bg-[#17212a] px-12 py-12 text-white lg:flex lg:flex-col lg:justify-between">
          <div
            aria-hidden="true"
            class="absolute -bottom-20 -left-24 h-96 w-96 rounded-full bg-[#b99c78]/20 blur-3xl"
          ></div>

          <div class="relative z-10">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#d6c3aa] text-sm font-bold text-[#d6c3aa]">
                C
              </div>

              <div>
                <p class="text-xl font-semibold tracking-tight">
                  ClientFlow
                </p>

                <p class="text-sm text-slate-400">
                  CRM
                </p>
              </div>
            </div>
          </div>

          <div class="relative z-10 max-w-xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#d6c3aa]">
              Work smarter
            </p>

            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight">
              Build stronger client relationships.
            </h2>

            <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">
              Manage contacts, opportunities, follow-ups, tasks, and client
              activity from one focused workspace.
            </p>
          </div>

          <p class="relative z-10 text-sm text-slate-500">
            Built with Ruby on Rails · Turbo · Tailwind CSS
          </p>
        </section>

        <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-[#eef1f4] via-[#f5f0eb] to-[#dbe3ec] px-6 py-10 sm:px-10">
          <div
            aria-hidden="true"
            class="absolute -bottom-44 -right-40 h-96 w-96 rounded-full bg-[#cfdae8]/80 blur-3xl"
          ></div>

          <div class="relative z-10 w-full max-w-lg">
            <% if notice.present? %>
              <div
                data-turbo-temporary
                class="mb-6 rounded-xl border border-[#cfdccf] bg-[#eef4ed] px-4 py-3 text-sm text-[#315542]"
                role="alert"
              >
                <%= notice %>
              </div>
            <% end %>

            <% if alert.present? &&
                  alert != "You need to sign in or sign up before continuing." %>
              <div
                data-turbo-temporary
                class="mb-6 rounded-xl border border-[#ead1ce] bg-[#f8efed] px-4 py-3 text-sm text-[#834840]"
                role="alert"
              >
                <%= alert %>
              </div>
            <% end %>

            <main>
              <%= yield %>
            </main>
          </div>
        </section>
      </div>
    <% end %>
  </body>
</html>