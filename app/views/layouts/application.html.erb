<!DOCTYPE html>
<html>
  <head>
    <title>ClientFlow CRM</title>

    <meta
      name="viewport"
      content="width=device-width,initial-scale=1"
    >

    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag "tailwind",
                            "data-turbo-track": "reload" %>

    <%= stylesheet_link_tag "application",
                            "data-turbo-track": "reload" %>

    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-[#eef0f3] text-[#18202a] antialiased">
    <% if user_signed_in? %>
      <div class="relative min-h-screen overflow-hidden lg:flex">
        <div
          aria-hidden="true"
          class="pointer-events-none fixed inset-0 -z-10 bg-gradient-to-br from-[#eceff3] via-[#f6f1ec] to-[#dce4ef]"
        ></div>

        <div
          aria-hidden="true"
          class="pointer-events-none fixed -bottom-48 left-32 -z-10 h-[34rem] w-[70rem] rounded-[50%] bg-gradient-to-r from-[#d8dee8]/80 via-[#c9d4e4]/70 to-[#eadfd5]/60 blur-3xl"
        ></div>

        <div
          aria-hidden="true"
          class="pointer-events-none fixed -right-36 -top-44 -z-10 h-[32rem] w-[32rem] rounded-full bg-[#efe0d4]/50 blur-3xl"
        ></div>

        <aside class="relative z-20 flex border-b border-white/10 bg-[#17212a] text-white shadow-2xl shadow-slate-950/10 lg:fixed lg:inset-y-0 lg:left-0 lg:w-60 lg:flex-col lg:border-b-0">
          <div
            aria-hidden="true"
            class="pointer-events-none absolute -bottom-20 -left-24 h-72 w-72 rounded-full bg-[#b99c78]/15 blur-3xl"
          ></div>

          <div class="relative flex w-full items-center justify-between px-6 py-6 lg:block">
            <%= link_to root_path,
                        class: "flex items-center gap-3" do %>
              <div class="flex h-9 w-9 items-center justify-center rounded-full border-2 border-[#d6c3aa] text-[#d6c3aa]">
                <span class="text-sm font-bold">C</span>
              </div>

              <span class="text-xl font-semibold tracking-[-0.02em] text-white">
                ClientFlow
              </span>
            <% end %>
          </div>

          <nav class="relative flex flex-1 gap-1 overflow-x-auto px-4 pb-5 lg:block lg:space-y-1 lg:overflow-visible">
            <%= link_to root_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{current_page?(root_path) ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M3 11.5 12 4l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1v-8.5Z" />
              </svg>

              Dashboard
            <% end %>

            <%= link_to clients_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/clients") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM22 21v-2a4 4 0 0 0-3-3.87M16 3.13a4 4 0 1 0 7.75" />
              </svg>

              Clients
            <% end %>

            <%= link_to leads_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/leads") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 2 4 5v6c0 5 3.4 9.7 8 11 4.6-1.3 8-6 8-11V5l-8-3ZM9 12l2 2 4-4" />
              </svg>

              Leads
            <% end %>

            <%= link_to deals_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/deals") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16v13H4V7Zm4 0V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2M4 12h16" />
              </svg>

              Deals
            <% end %>

            <%= link_to tasks_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/tasks") ? "bg-white/10 text-white shadow-sm" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <circle cx="12" cy="12" r="9" />
                <path stroke-linecap="round" stroke-linejoin="round" d="m8.5 12 2.2 2.2 4.8-5" />
              </svg>

              Tasks
            <% end %>

            <%= link_to reports_path,
                        class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/reports") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
              <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 20V10M10 20V4M16 20v-7M22 20H2" />
              </svg>

              Reports
            <% end %>

            <% if current_user.admin? %>
              <%= link_to workspace_invitations_path,
                          class: "group flex shrink-0 items-center gap-3 rounded-xl px-4 py-3 text-sm font-medium transition #{request.path.start_with?("/workspace_invitations") ? "bg-white/10 text-white" : "text-slate-300 hover:bg-white/[0.07] hover:text-white"}" do %>
                <svg class="h-5 w-5 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2M9 11a4 4 0 1 0 0-8 4 4 0 0 0 0 8ZM19 8v6M22 11h-6" />
                </svg>

                Team
              <% end %>
            <% end %>
          </nav>

          <div
            class="relative hidden p-4 lg:block"
            data-controller="account-dropdown"
          >
            <div
              data-account-dropdown-target="panel"
              class="absolute bottom-full left-4 right-4 z-50 mb-3 hidden overflow-hidden rounded-2xl border border-white/[0.08] bg-[#202c36]/95 shadow-[0_22px_60px_rgba(0,0,0,0.35)] backdrop-blur-xl"
            >
              <div class="border-b border-white/[0.07] px-4 py-4">
                <div class="flex items-center gap-3">
                  <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-white">
                    <%= avatar_initials(current_user.full_name) %>
                  </div>

                  <div class="min-w-0">
                    <p class="truncate text-sm font-semibold text-white">
                      <%= current_user.full_name %>
                    </p>

                    <p class="mt-0.5 truncate text-xs text-slate-400">
                      <%= current_user.email %>
                    </p>
                  </div>
                </div>
              </div>

              <div class="p-2">
                <%= link_to edit_user_registration_path,
                            class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/[0.07] hover:text-white" do %>
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                    <circle cx="12" cy="8" r="4" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 21a8 8 0 0 1 16 0" />
                  </svg>

                  Account settings
                <% end %>

                <%= link_to destroy_user_session_path,
                            data: {
                              turbo_method: :delete
                            },
                            class: "flex items-center gap-3 rounded-xl px-3 py-2.5 text-sm font-medium text-slate-200 transition hover:bg-white/[0.07] hover:text-white" do %>
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 17l5-5-5-5M15 12H3M14 4h5a2 2 0 0 1 2 2v12a2 2 0 0 1-2 2h-5" />
                  </svg>

                  Sign out
                <% end %>
              </div>

              <div class="border-t border-white/[0.07] p-2">
                <%= button_to registration_path(:user),
                              method: :delete,
                              data: {
                                turbo_confirm: "Are you sure you want to delete your account? You will be signed out immediately."
                              },
                              form: {
                                class: "w-full"
                              },
                              class: "flex w-full items-center gap-3 rounded-xl px-3 py-2.5 text-left text-sm font-medium text-[#e3a7a0] transition hover:bg-[#8a4038]/15 hover:text-[#f0b8b1]" do %>
                  <svg class="h-4 w-4 shrink-0" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M10 11v6M14 11v6M6 7l1 14h10l1-14M9 7V4h6v3" />
                  </svg>

                  Delete account
                <% end %>
              </div>
            </div>

            <button
              type="button"
              aria-expanded="false"
              aria-haspopup="true"
              data-account-dropdown-target="button"
              data-action="click->account-dropdown#toggle"
              class="w-full rounded-2xl border border-white/[0.07] bg-white/[0.04] p-3.5 text-left transition hover:border-white/[0.12] hover:bg-white/[0.07] focus:outline-none focus:ring-2 focus:ring-white/10"
            >
              <div class="flex items-center gap-3">
                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full bg-white/10 text-xs font-semibold text-white">
                  <%= avatar_initials(current_user.full_name) %>
                </div>

                <div class="min-w-0 flex-1">
                  <p class="truncate text-sm font-medium text-white">
                    <%= current_user.full_name %>
                  </p>

                  <p class="mt-0.5 text-xs text-slate-400">
                    <%= current_user.role.titleize %>
                  </p>
                </div>

                <svg
                  data-account-dropdown-target="chevron"
                  class="h-4 w-4 text-slate-500 transition-transform duration-200"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.7"
                  viewBox="0 0 24 24"
                >
                  <path stroke-linecap="round" stroke-linejoin="round" d="m6 9 6 6 6-6" />
                </svg>
              </div>
            </button>
          </div>
        </aside>

        <div class="relative z-10 flex min-h-screen min-w-0 flex-1 flex-col lg:ml-60">
          <header class="border-b border-[#d8d9dc]/80 bg-white/35 backdrop-blur-xl">
            <div class="flex min-h-[88px] items-center justify-between gap-4 px-6 lg:px-10">
              <div>
                <p class="text-xl font-semibold tracking-[-0.02em] text-[#17212a]">
                  <%= content_for?(:page_title) ? yield(:page_title) : "ClientFlow" %>
                </p>
              </div>

              <div class="flex items-center gap-2">
                <div
                  class="relative"
                  data-controller="notification-dropdown"
                >
                  <button
                    type="button"
                    aria-label="<%= @unread_notifications_count.positive? ?
                      "#{@unread_notifications_count} unread notifications" :
                      "Notifications" %>"
                    aria-expanded="false"
                    aria-haspopup="true"
                    data-notification-dropdown-target="button"
                    data-action="click->notification-dropdown#toggle"
                    class="relative flex h-11 w-11 items-center justify-center rounded-xl border border-[#d6d3cf] bg-white/55 text-[#465563] transition hover:bg-white hover:text-[#27333e] focus:outline-none focus:ring-2 focus:ring-[#cfdccf]"
                  >
                    <svg
                      class="h-5 w-5"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.7"
                      viewBox="0 0 24 24"
                      aria-hidden="true"
                    >
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 17H9m8-6a5 5 0 1 0-10 0c0 5-2 6-2 6h14s-2-1-2-6ZM10 21h4"
                      />
                    </svg>

                    <% if @unread_notifications_count.positive? %>
                      <span
                        class="absolute -right-1 -top-1 flex min-h-5 min-w-5 items-center justify-center rounded-full border-2 border-[#f1f0ee] bg-[#55705f] px-1 text-[10px] font-bold leading-none text-white"
                      >
                        <%= @unread_notifications_count > 99 ?
                              "99+" :
                              @unread_notifications_count %>
                      </span>
                    <% end %>
                  </button>

                  <div
                    data-notification-dropdown-target="panel"
                    class="absolute right-0 z-50 mt-3 hidden w-[24rem] max-w-[calc(100vw-2rem)] overflow-hidden rounded-2xl border border-[#d8d9dc] bg-[#f9f9f7]/95 shadow-[0_22px_60px_rgba(23,33,42,0.16)] backdrop-blur-xl"
                  >
                    <div class="flex items-center justify-between border-b border-[#dedfdf] px-5 py-4">
                      <div>
                        <p class="font-semibold text-[#27333e]">
                          Notifications
                        </p>

                        <% if @unread_notifications_count.positive? %>
                          <p class="mt-0.5 text-xs text-[#68747e]">
                            <%= pluralize(
                                  @unread_notifications_count,
                                  "unread notification"
                                ) %>
                          </p>
                        <% else %>
                          <p class="mt-0.5 text-xs text-[#68747e]">
                            You're all caught up
                          </p>
                        <% end %>
                      </div>

                      <% if @unread_notifications_count.positive? %>
                        <%= button_to "Mark all read",
                                      read_all_notifications_path,
                                      method: :patch,
                                      class: "text-xs font-semibold text-[#55705f] transition hover:text-[#315542]" %>
                      <% end %>
                    </div>

                    <% if @recent_notifications.any? %>
                      <div class="max-h-[27rem] overflow-y-auto">
                        <% @recent_notifications.each do |notification| %>
                          <% if notification.read? %>
                            <%= link_to client_path(
                                          notification.task.client,
                                          anchor: "tasks_section"
                                        ),
                                        class: "block border-b border-[#e5e5e2] bg-transparent px-5 py-4 transition last:border-b-0 hover:bg-[#f3f5f2] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#cfdccf]" do %>
                              <div class="flex gap-3">
                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#d5ddd7] bg-white/80 text-xs font-semibold text-[#416550]">
                                  <%= avatar_initials(notification.actor.full_name) %>
                                </div>

                                <div class="min-w-0 flex-1">
                                  <div class="flex items-start gap-2">
                                    <p class="min-w-0 flex-1 text-sm font-medium leading-5 text-[#27333e]">
                                      <%= notification.message %>
                                    </p>
                                  </div>

                                  <p class="mt-1 truncate text-xs text-[#68747e]">
                                    <%= notification.task.client.full_name %>
                                  </p>

                                  <div class="mt-2 flex items-center justify-between gap-3">
                                    <p class="text-[11px] text-[#8a949d]">
                                      <%= time_ago_in_words(notification.created_at) %> ago
                                    </p>

                                    <span class="text-xs font-semibold text-[#55705f]">
                                      View task
                                    </span>
                                  </div>
                                </div>
                              </div>
                            <% end %>
                          <% else %>
                            <%= button_to read_notification_path(notification),
                                          method: :patch,
                                          form: {
                                            class: "block w-full"
                                          },
                                          class: "block w-full border-b border-[#e5e5e2] bg-[#eef4ed]/55 px-5 py-4 text-left transition last:border-b-0 hover:bg-[#e7efe6] focus:outline-none focus:ring-2 focus:ring-inset focus:ring-[#cfdccf]" do %>
                              <div class="flex gap-3">
                                <div class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-[#d5ddd7] bg-white/80 text-xs font-semibold text-[#416550]">
                                  <%= avatar_initials(notification.actor.full_name) %>
                                </div>

                                <div class="min-w-0 flex-1">
                                  <div class="flex items-start gap-2">
                                    <p class="min-w-0 flex-1 text-sm font-medium leading-5 text-[#27333e]">
                                      <%= notification.message %>
                                    </p>

                                    <span
                                      class="mt-1.5 h-2 w-2 shrink-0 rounded-full bg-[#55705f]"
                                      aria-label="Unread"
                                    ></span>
                                  </div>

                                  <p class="mt-1 truncate text-xs text-[#68747e]">
                                    <%= notification.task.client.full_name %>
                                  </p>

                                  <div class="mt-2 flex items-center justify-between gap-3">
                                    <p class="text-[11px] text-[#8a949d]">
                                      <%= time_ago_in_words(notification.created_at) %> ago
                                    </p>

                                    <span class="text-xs font-semibold text-[#55705f]">
                                      View task
                                    </span>
                                  </div>
                                </div>
                              </div>
                            <% end %>
                          <% end %>
                        <% end %>
                      </div>
                    <% else %>
                      <div class="px-6 py-10 text-center">
                        <div class="mx-auto flex h-10 w-10 items-center justify-center rounded-full border border-[#dedfdf] bg-white/60 text-[#68747e]">
                          <svg
                            class="h-4 w-4"
                            fill="none"
                            stroke="currentColor"
                            stroke-width="1.7"
                            viewBox="0 0 24 24"
                            aria-hidden="true"
                          >
                            <path
                              stroke-linecap="round"
                              stroke-linejoin="round"
                              d="M15 17H9m8-6a5 5 0 1 0-10 0c0 5-2 6-2 6h14s-2-1-2-6ZM10 21h4"
                            />
                          </svg>
                        </div>

                        <p class="mt-3 text-sm font-semibold text-[#27333e]">
                          No notifications
                        </p>

                        <p class="mt-1 text-xs text-[#68747e]">
                          New task assignments will appear here.
                        </p>
                      </div>
                    <% end %>

                    <div class="border-t border-[#dedfdf] bg-white/35 px-5 py-3.5">
                      <%= link_to notifications_path,
                                  class: "flex items-center justify-center gap-2 text-sm font-semibold text-[#416550] transition hover:text-[#315542]" do %>
                        View all notifications

                        <span aria-hidden="true">→</span>
                      <% end %>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </header>

          <% if notice.present? %>
            <div
              data-turbo-temporary
              class="mx-6 mt-5 flex items-center gap-3 rounded-xl border border-[#cfdccf] bg-[#eef4ed]/90 px-4 py-3 text-sm text-[#315542] shadow-sm lg:mx-10"
              role="alert"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#dce8dc] text-xs font-bold">
                ✓
              </span>

              <%= notice %>
            </div>
          <% end %>

          <% if alert.present? %>
            <div
              data-turbo-temporary
              class="mx-6 mt-5 flex items-center gap-3 rounded-xl border border-[#ead1ce] bg-[#f8efed]/90 px-4 py-3 text-sm text-[#834840] shadow-sm lg:mx-10"
              role="alert"
            >
              <span class="flex h-6 w-6 items-center justify-center rounded-full bg-[#f0ddda] text-xs font-bold">
                !
              </span>

              <%= alert %>
            </div>
          <% end %>

          <main class="flex-1 px-5 py-7 sm:px-6 lg:px-8 xl:px-10">
            <%= yield %>
          </main>
        </div>
      </div>
    <% else %>
      <div class="min-h-screen lg:grid lg:grid-cols-2">
        <section class="relative hidden overflow-hidden bg-[#17212a] px-12 py-12 text-white lg:flex lg:flex-col lg:justify-between">
          <div
            aria-hidden="true"
            class="absolute -bottom-20 -left-24 h-96 w-96 rounded-full bg-[#b99c78]/20 blur-3xl"
          ></div>

          <div class="relative z-10">
            <div class="flex items-center gap-4">
              <div class="flex h-12 w-12 items-center justify-center rounded-full border-2 border-[#d6c3aa] text-sm font-bold text-[#d6c3aa]">
                C
              </div>

              <div>
                <p class="text-xl font-semibold tracking-tight">
                  ClientFlow
                </p>

                <p class="text-sm text-slate-400">
                  CRM
                </p>
              </div>
            </div>
          </div>

          <div class="relative z-10 max-w-xl">
            <p class="text-sm font-semibold uppercase tracking-[0.18em] text-[#d6c3aa]">
              Work smarter
            </p>

            <h2 class="mt-5 text-4xl font-semibold leading-tight tracking-tight">
              Build stronger client relationships.
            </h2>

            <p class="mt-5 max-w-lg text-base leading-7 text-slate-300">
              Manage contacts, opportunities, follow-ups, tasks, and client
              activity from one focused workspace.
            </p>
          </div>

          <p class="relative z-10 text-sm text-slate-500">
            Built with Ruby on Rails · Turbo · Tailwind CSS
          </p>
        </section>

        <section class="relative flex min-h-screen items-center justify-center overflow-hidden bg-gradient-to-br from-[#eef1f4] via-[#f5f0eb] to-[#dbe3ec] px-6 py-10 sm:px-10">
          <div
            aria-hidden="true"
            class="absolute -bottom-44 -right-40 h-96 w-96 rounded-full bg-[#cfdae8]/80 blur-3xl"
          ></div>

          <div class="relative z-10 w-full max-w-lg">
            <% if notice.present? %>
              <div
                data-turbo-temporary
                class="mb-6 rounded-xl border border-[#cfdccf] bg-[#eef4ed] px-4 py-3 text-sm text-[#315542]"
                role="alert"
              >
                <%= notice %>
              </div>
            <% end %>

            <% if alert.present? &&
                  alert != "You need to sign in or sign up before continuing." %>
              <div
                data-turbo-temporary
                class="mb-6 rounded-xl border border-[#ead1ce] bg-[#f8efed] px-4 py-3 text-sm text-[#834840]"
                role="alert"
              >
                <%= alert %>
              </div>
            <% end %>

            <main>
              <%= yield %>
            </main>
          </div>
        </section>
      </div>
    <% end %>
  </body>
</html>