<div class="space-y-8">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
        Dashboard
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
        Welcome back, <%= current_user.first_name %>!
      </h1>

      <p class="mt-2 text-gray-600">
        Here is an overview of your client relationships and sales activity.
      </p>
    </div>

    <%= link_to "Add client",
                new_client_path,
                class: "rounded-lg bg-indigo-600 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-indigo-700" %>
  </section>

  <section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Total clients</p>
          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @total_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-blue-50 px-3 py-2 text-lg text-blue-700">
          C
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        All clients in your CRM.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Active leads</p>
          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @lead_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-amber-50 px-3 py-2 text-lg text-amber-700">
          L
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        Potential clients to follow up with.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Active clients</p>
          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @active_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-green-50 px-3 py-2 text-lg text-green-700">
          A
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        Current active client relationships.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">Pending tasks</p>
          <p class="mt-3 text-3xl font-bold text-gray-900">0</p>
        </div>

        <div class="rounded-lg bg-purple-50 px-3 py-2 text-lg text-purple-700">
          T
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        Task management is coming soon.
      </p>
    </article>
  </section>

  <section class="grid gap-6 xl:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:col-span-2">
      <div class="border-b border-gray-200 px-6 py-5">
        <h2 class="text-lg font-semibold text-gray-900">Recent activity</h2>
        <p class="mt-1 text-sm text-gray-500">
          Your latest CRM updates will appear here.
        </p>
      </div>

      <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-gray-100 text-xl font-semibold text-gray-500">
          +
        </div>

        <h3 class="mt-4 font-semibold text-gray-900">No activity yet</h3>

        <p class="mt-2 max-w-sm text-sm text-gray-500">
          Once activity tracking is added, your latest client updates will
          appear here.
        </p>
      </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-6 py-5">
        <h2 class="text-lg font-semibold text-gray-900">Quick actions</h2>
        <p class="mt-1 text-sm text-gray-500">
          Common actions for managing your CRM.
        </p>
      </div>

      <div class="space-y-3 p-6">
        <%= link_to "Add a new client",
                    new_client_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "View all clients",
                    clients_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <button
          type="button"
          disabled
          class="w-full cursor-not-allowed rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-400"
        >
          Create a task
        </button>
      </div>
    </div>
  </section>
</div>