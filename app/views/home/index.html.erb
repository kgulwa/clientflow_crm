<div class="space-y-8">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
        Dashboard
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
        Welcome back, <%= current_user.first_name %>!
      </h1>

      <p class="mt-2 text-gray-600">
        Here is an overview of your clients, leads, deals, and upcoming work.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Add lead",
                  new_lead_path,
                  class: "rounded-lg border border-indigo-600 px-5 py-3 text-center text-sm font-semibold text-indigo-600 transition hover:bg-indigo-50" %>

      <%= link_to "Add client",
                  new_client_path,
                  class: "rounded-lg bg-indigo-600 px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-indigo-700" %>
    </div>
  </section>

  <section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">
            Total clients
          </p>

          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @total_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-blue-50 px-3 py-2 text-lg font-semibold text-blue-700">
          C
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        All clients in your CRM.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">
            Active leads
          </p>

          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @lead_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-amber-50 px-3 py-2 text-lg font-semibold text-amber-700">
          L
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        Potential clients tracked as client records.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">
            Active clients
          </p>

          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @active_clients %>
          </p>
        </div>

        <div class="rounded-lg bg-green-50 px-3 py-2 text-lg font-semibold text-green-700">
          A
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        Current active client relationships.
      </p>
    </article>

    <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-gray-500">
            Pending tasks
          </p>

          <p class="mt-3 text-3xl font-bold text-gray-900">
            <%= @pending_tasks_count %>
          </p>
        </div>

        <div class="rounded-lg bg-purple-50 px-3 py-2 text-lg font-semibold text-purple-700">
          T
        </div>
      </div>

      <p class="mt-4 text-sm text-gray-500">
        <%= pluralize(@overdue_tasks_count, "overdue task") %>.
      </p>
    </article>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-xl border border-red-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-red-100 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Overdue tasks
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Tasks that need your immediate attention.
          </p>
        </div>

        <span class="rounded-full bg-red-50 px-3 py-1 text-sm font-semibold text-red-700">
          <%= pluralize(@overdue_tasks_count, "overdue task") %>
        </span>
      </div>

      <% if @overdue_tasks.any? %>
        <div class="divide-y divide-gray-200">
          <% @overdue_tasks.each do |task| %>
            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-900">
                    <%= task.title %>
                  </h3>

                  <span class="inline-flex rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">
                    Overdue
                  </span>

                  <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
                    <%= task.priority.titleize %> priority
                  </span>
                </div>

                <p class="mt-2 text-sm text-gray-500">
                  <%= task.client.full_name %>
                  ·
                  Due <%= task.due_date.strftime("%B %-d, %Y") %>
                </p>
              </div>

              <%= link_to "View client",
                          client_path(task.client),
                          class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-56 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-50 text-xl font-semibold text-green-700">
            ✓
          </div>

          <h3 class="mt-4 font-semibold text-gray-900">
            No overdue tasks
          </h3>

          <p class="mt-2 max-w-sm text-sm text-gray-500">
            Everything is currently on schedule.
          </p>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Recently added clients
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Your five newest client records.
          </p>
        </div>

        <%= link_to "View all clients",
                    clients_path,
                    class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
      </div>

      <% if @recent_clients.any? %>
        <div class="divide-y divide-gray-200">
          <% @recent_clients.each do |client| %>
            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-900">
                    <%= client.full_name %>
                  </h3>

                  <span class="inline-flex rounded-full bg-blue-50 px-2.5 py-1 text-xs font-semibold text-blue-700">
                    <%= client.status.titleize %>
                  </span>
                </div>

                <p class="mt-2 text-sm text-gray-500">
                  <%= client.company_name.presence || "No company added" %>
                  ·
                  Added <%= time_ago_in_words(client.created_at) %> ago
                </p>
              </div>

              <%= link_to "View client",
                          client_path(client),
                          class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-56 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-blue-50 text-xl font-semibold text-blue-700">
            C
          </div>

          <h3 class="mt-4 font-semibold text-gray-900">
            No clients yet
          </h3>

          <p class="mt-2 max-w-sm text-sm text-gray-500">
            Add your first client to start building your CRM.
          </p>

          <%= link_to "Add your first client",
                      new_client_path,
                      class: "mt-5 text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Leads by status
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            A complete view of your current lead pipeline.
          </p>
        </div>

        <%= link_to "View leads",
                    leads_path,
                    class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
      </div>

      <div class="space-y-3 p-6">
        <div class="flex items-center justify-between rounded-lg bg-gray-50 px-4 py-3">
          <span class="text-sm font-medium text-gray-700">
            Total leads
          </span>

          <span class="text-lg font-bold text-gray-900">
            <%= @total_leads %>
          </span>
        </div>

        <% @lead_status_counts.each do |status, count| %>
          <% status_classes = case status
                              when "qualified"
                                "bg-green-50 text-green-700"
                              when "contacted"
                                "bg-blue-50 text-blue-700"
                              when "converted"
                                "bg-purple-50 text-purple-700"
                              when "lost"
                                "bg-red-50 text-red-700"
                              else
                                "bg-amber-50 text-amber-700"
                              end %>

          <div class="flex items-center justify-between rounded-lg px-4 py-3 <%= status_classes %>">
            <span class="text-sm font-medium">
              <%= status == "new_lead" ? "New" : status.humanize %>
            </span>

            <span class="text-lg font-bold">
              <%= count %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Deals by stage
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Track opportunities as they move through your pipeline.
          </p>
        </div>

        <%= link_to "View deals",
                    deals_path,
                    class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
      </div>

      <div class="p-6">
        <div class="rounded-xl bg-indigo-50 p-5">
          <p class="text-sm font-medium text-indigo-700">
            Open pipeline value
          </p>

          <p class="mt-2 text-3xl font-bold text-indigo-900">
            <%= number_to_currency(
                  @open_pipeline_value,
                  unit: "R",
                  delimiter: ",",
                  separator: "."
                ) %>
          </p>

          <p class="mt-2 text-sm text-indigo-700">
            Excludes won and lost deals.
          </p>
        </div>

        <div class="mt-5 space-y-3">
          <% @deal_stage_counts.each do |stage, count| %>
            <% stage_classes = case stage
                               when "won"
                                 "bg-green-50 text-green-700"
                               when "lost"
                                 "bg-red-50 text-red-700"
                               when "negotiation"
                                 "bg-purple-50 text-purple-700"
                               when "proposal_sent"
                                 "bg-blue-50 text-blue-700"
                               else
                                 "bg-gray-50 text-gray-700"
                               end %>

            <div class="flex items-center justify-between rounded-lg px-4 py-3 <%= stage_classes %>">
              <span class="text-sm font-medium">
                <%= stage.humanize %>
              </span>

              <span class="text-lg font-bold">
                <%= count %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white shadow-sm xl:col-span-2">
      <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Recent leads
          </h2>

          <p class="mt-1 text-sm text-gray-500">
            Your five most recently added sales opportunities.
          </p>
        </div>

        <%= link_to "View all leads",
                    leads_path,
                    class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
      </div>

      <% if @recent_leads.any? %>
        <div class="divide-y divide-gray-200">
          <% @recent_leads.each do |lead| %>
            <% status_classes = case lead.status
                                when "qualified"
                                  "bg-green-50 text-green-700"
                                when "contacted"
                                  "bg-blue-50 text-blue-700"
                                when "lost"
                                  "bg-red-50 text-red-700"
                                when "converted"
                                  "bg-purple-50 text-purple-700"
                                else
                                  "bg-amber-50 text-amber-700"
                                end %>

            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-900">
                    <%= lead.full_name %>
                  </h3>

                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= status_classes %>">
                    <%= lead.display_status %>
                  </span>
                </div>

                <p class="mt-2 text-sm text-gray-500">
                  <%= lead.company_name.presence || "No company added" %>
                  ·
                  <%= lead.source == "linkedin" ? "LinkedIn" : lead.source.titleize %>
                </p>
              </div>

              <%= link_to "View lead",
                          lead_path(lead),
                          class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-amber-50 text-xl font-semibold text-amber-700">
            L
          </div>

          <h3 class="mt-4 font-semibold text-gray-900">
            No leads yet
          </h3>

          <p class="mt-2 max-w-sm text-sm text-gray-500">
            Add your first lead to begin tracking new sales opportunities.
          </p>

          <%= link_to "Add your first lead",
                      new_lead_path,
                      class: "mt-5 text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
        </div>
      <% end %>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-6 py-5">
        <h2 class="text-lg font-semibold text-gray-900">
          Quick actions
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Common actions for managing your CRM.
        </p>
      </div>

      <div class="space-y-3 p-6">
        <%= link_to "Add a new lead",
                    new_lead_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "View all leads",
                    leads_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "Add a new client",
                    new_client_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "View all clients",
                    clients_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "View all deals",
                    deals_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>

        <%= link_to "Manage tasks",
                    tasks_path,
                    class: "block w-full rounded-lg border border-gray-200 px-4 py-3 text-left text-sm font-medium text-gray-700 transition hover:border-indigo-300 hover:bg-indigo-50 hover:text-indigo-700" %>
      </div>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white shadow-sm">
    <div class="flex items-center justify-between border-b border-gray-200 px-6 py-5">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">
          Upcoming tasks
        </h2>

        <p class="mt-1 text-sm text-gray-500">
          Your next scheduled client follow-ups and deadlines.
        </p>
      </div>

      <%= link_to "View all tasks",
                  tasks_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
    </div>

    <% if @upcoming_tasks.any? %>
      <div class="divide-y divide-gray-200">
        <% @upcoming_tasks.each do |task| %>
          <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <h3 class="font-semibold text-gray-900">
                  <%= task.title %>
                </h3>

                <span class="inline-flex rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">
                  <%= task.priority.titleize %> priority
                </span>

                <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
                  <%= task.status.humanize %>
                </span>
              </div>

              <p class="mt-2 text-sm text-gray-500">
                <%= task.client.full_name %>
                ·
                Due <%= task.due_date.strftime("%B %-d, %Y") %>
              </p>
            </div>

            <%= link_to "View client",
                        client_path(task.client),
                        class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-12 w-12 items-center justify-center rounded-full bg-green-50 text-xl font-semibold text-green-700">
          ✓
        </div>

        <h3 class="mt-4 font-semibold text-gray-900">
          No upcoming tasks
        </h3>

        <p class="mt-2 max-w-sm text-sm text-gray-500">
          You have no pending or in-progress tasks scheduled for today or later.
        </p>
      </div>
    <% end %>
  </section>
</div>
