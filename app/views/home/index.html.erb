<div class="space-y-8">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-500">
        Dashboard
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">
        Welcome back, <%= current_user.first_name %>!
      </h1>

      <p class="mt-2 text-slate-600">
        Here is an overview of your clients, leads, deals, and upcoming work.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Add lead",
                  new_lead_path,
                  class: "rounded-xl border border-slate-300 bg-white/60 px-5 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-white hover:text-slate-900" %>

      <%= link_to "Add client",
                  new_client_path,
                  class: "rounded-xl bg-slate-800 px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
    </div>
  </section>

  <section class="grid gap-5 sm:grid-cols-2 xl:grid-cols-4">
    <article class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Total clients
          </p>

          <p class="mt-3 text-3xl font-bold text-slate-900">
            <%= @total_clients %>
          </p>
        </div>

        <div class="rounded-xl bg-slate-100 px-3 py-2 text-lg font-semibold text-slate-700">
          C
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        All clients in your CRM.
      </p>
    </article>

    <article class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Active leads
          </p>

          <p class="mt-3 text-3xl font-bold text-slate-900">
            <%= @lead_clients %>
          </p>
        </div>

        <div class="rounded-xl bg-[#f5ead7] px-3 py-2 text-lg font-semibold text-[#9b661f]">
          L
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Potential clients tracked as client records.
      </p>
    </article>

    <article class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Active clients
          </p>

          <p class="mt-3 text-3xl font-bold text-slate-900">
            <%= @active_clients %>
          </p>
        </div>

        <div class="rounded-xl bg-[#e5eee8] px-3 py-2 text-lg font-semibold text-[#3e7157]">
          A
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        Current active client relationships.
      </p>
    </article>

    <article class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
      <div class="flex items-start justify-between">
        <div>
          <p class="text-sm font-medium text-slate-500">
            Pending tasks
          </p>

          <p class="mt-3 text-3xl font-bold text-slate-900">
            <%= @pending_tasks_count %>
          </p>
        </div>

        <div class="rounded-xl bg-[#ecebea] px-3 py-2 text-lg font-semibold text-[#55616c]">
          T
        </div>
      </div>

      <p class="mt-4 text-sm text-slate-500">
        <%= pluralize(@overdue_tasks_count, "overdue task") %>.
      </p>
    </article>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Overdue tasks
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Tasks that need your immediate attention.
          </p>
        </div>

        <span class="rounded-full bg-[#f3e3e0] px-3 py-1 text-sm font-semibold text-[#9d443d]">
          <%= pluralize(@overdue_tasks_count, "overdue task") %>
        </span>
      </div>

      <% if @overdue_tasks.any? %>
        <div class="divide-y divide-stone-200">
          <% @overdue_tasks.each do |task| %>
            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-slate-900">
                    <%= task.title %>
                  </h3>

                  <span class="inline-flex rounded-full bg-[#f3e3e0] px-2.5 py-1 text-xs font-semibold text-[#9d443d]">
                    Overdue
                  </span>

                  <% priority_classes = case task.priority
                                        when "high"
                                          "bg-[#f3e3e0] text-[#9d443d]"
                                        when "low"
                                          "bg-[#e5eee8] text-[#3e7157]"
                                        else
                                          "bg-[#f5ead7] text-[#9b661f]"
                                        end %>

                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= priority_classes %>">
                    <%= task.priority.titleize %> priority
                  </span>
                </div>

                <p class="mt-2 text-sm text-slate-500">
                  <%= task.client.full_name %>
                  ·
                  Due <%= task.due_date.strftime("%B %-d, %Y") %>
                </p>
              </div>

              <%= link_to "View client",
                          client_path(task.client),
                          class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-56 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#e5eee8] text-xl font-semibold text-[#3e7157]">
            ✓
          </div>

          <h3 class="mt-4 font-semibold text-slate-900">
            No overdue tasks
          </h3>

          <p class="mt-2 max-w-sm text-sm text-slate-500">
            Everything is currently on schedule.
          </p>
        </div>
      <% end %>
    </div>

    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Recently added clients
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Your five newest client records.
          </p>
        </div>

        <%= link_to "View all clients",
                    clients_path,
                    class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
      </div>

      <% if @recent_clients.any? %>
        <div class="divide-y divide-stone-200">
          <% @recent_clients.each do |client| %>
            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-slate-900">
                    <%= client.full_name %>
                  </h3>

                  <% client_status_classes = case client.status
                                             when "active"
                                               "bg-[#e5eee8] text-[#3e7157]"
                                             when "inactive"
                                               "bg-[#ecebea] text-[#55616c]"
                                             else
                                               "bg-[#f5ead7] text-[#9b661f]"
                                             end %>

                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= client_status_classes %>">
                    <%= client.status.titleize %>
                  </span>
                </div>

                <p class="mt-2 text-sm text-slate-500">
                  <%= client.company_name.presence || "No company added" %>
                  ·
                  Added <%= time_ago_in_words(client.created_at) %> ago
                </p>
              </div>

              <%= link_to "View client",
                          client_path(client),
                          class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-56 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-slate-100 text-xl font-semibold text-slate-600">
            C
          </div>

          <h3 class="mt-4 font-semibold text-slate-900">
            No clients yet
          </h3>

          <p class="mt-2 max-w-sm text-sm text-slate-500">
            Add your first client to start building your CRM.
          </p>

          <%= link_to "Add your first client",
                      new_client_path,
                      class: "mt-5 text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
        </div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-2">
    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Leads by status
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            A complete view of your current lead pipeline.
          </p>
        </div>

        <%= link_to "View leads",
                    leads_path,
                    class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
      </div>

      <div class="space-y-3 p-6">
        <div class="flex items-center justify-between rounded-xl bg-slate-100/80 px-4 py-3">
          <span class="text-sm font-medium text-slate-600">
            Total leads
          </span>

          <span class="text-lg font-bold text-slate-900">
            <%= @total_leads %>
          </span>
        </div>

        <% @lead_status_counts.each do |status, count| %>
          <% status_classes = case status
                              when "qualified"
                                "bg-[#e5eee8] text-[#3e7157]"
                              when "contacted"
                                "bg-[#e8edf3] text-[#3e5f7d]"
                              when "converted"
                                "bg-[#ecebea] text-[#55616c]"
                              when "lost"
                                "bg-[#f3e3e0] text-[#9d443d]"
                              else
                                "bg-[#f5ead7] text-[#9b661f]"
                              end %>

          <div class="flex items-center justify-between rounded-xl px-4 py-3 <%= status_classes %>">
            <span class="text-sm font-medium">
              <%= status == "new_lead" ? "New" : status.humanize %>
            </span>

            <span class="text-lg font-bold">
              <%= count %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
      <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Deals by stage
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Track opportunities as they move through your pipeline.
          </p>
        </div>

        <%= link_to "View deals",
                    deals_path,
                    class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
      </div>

      <div class="p-6">
        <div class="rounded-xl bg-[#e8edf3] p-5">
          <p class="text-sm font-medium text-[#3e5f7d]">
            Open pipeline value
          </p>

          <p class="mt-2 text-3xl font-bold text-slate-900">
            <%= number_to_currency(
                  @open_pipeline_value,
                  unit: "R",
                  delimiter: ",",
                  separator: "."
                ) %>
          </p>

          <p class="mt-2 text-sm text-[#3e5f7d]">
            Excludes won and lost deals.
          </p>
        </div>

        <div class="mt-5 space-y-3">
          <% @deal_stage_counts.each do |stage, count| %>
            <% stage_classes = case stage
                               when "won"
                                 "bg-[#e5eee8] text-[#3e7157]"
                               when "lost"
                                 "bg-[#f3e3e0] text-[#9d443d]"
                               when "negotiation"
                                 "bg-[#ecebea] text-[#55616c]"
                               when "proposal_sent"
                                 "bg-[#e8edf3] text-[#3e5f7d]"
                               else
                                 "bg-slate-100 text-slate-700"
                               end %>

            <div class="flex items-center justify-between rounded-xl px-4 py-3 <%= stage_classes %>">
              <span class="text-sm font-medium">
                <%= stage.humanize %>
              </span>

              <span class="text-lg font-bold">
                <%= count %>
              </span>
            </div>
          <% end %>
        </div>
      </div>
    </div>
  </section>

  <section class="grid gap-6 xl:grid-cols-3">
    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur xl:col-span-2">
      <div class="flex items-center justify-between border-b border-stone-200 px-6 py-5">
        <div>
          <h2 class="text-lg font-semibold text-slate-900">
            Upcoming tasks
          </h2>

          <p class="mt-1 text-sm text-slate-500">
            Your next scheduled client follow-ups and deadlines.
          </p>
        </div>

        <%= link_to "View all tasks",
                    tasks_path,
                    class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
      </div>

      <% if @upcoming_tasks.any? %>
        <div class="divide-y divide-stone-200">
          <% @upcoming_tasks.each do |task| %>
            <% priority_classes = case task.priority
                                  when "high"
                                    "bg-[#f3e3e0] text-[#9d443d]"
                                  when "low"
                                    "bg-[#e5eee8] text-[#3e7157]"
                                  else
                                    "bg-[#f5ead7] text-[#9b661f]"
                                  end %>

            <article class="flex flex-col justify-between gap-4 px-6 py-5 sm:flex-row sm:items-center">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-slate-900">
                    <%= task.title %>
                  </h3>

                  <span class="inline-flex rounded-full px-2.5 py-1 text-xs font-semibold <%= priority_classes %>">
                    <%= task.priority.titleize %> priority
                  </span>

                  <span class="inline-flex rounded-full bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-600">
                    <%= task.status.humanize %>
                  </span>
                </div>

                <p class="mt-2 text-sm text-slate-500">
                  <%= task.client.full_name %>
                  ·
                  Due <%= task.due_date.strftime("%B %-d, %Y") %>
                </p>
              </div>

              <%= link_to "View client",
                          client_path(task.client),
                          class: "text-sm font-semibold text-slate-700 transition hover:text-slate-950" %>
            </article>
          <% end %>
        </div>
      <% else %>
        <div class="flex min-h-64 flex-col items-center justify-center px-6 py-12 text-center">
          <div class="flex h-12 w-12 items-center justify-center rounded-full bg-[#e5eee8] text-xl font-semibold text-[#3e7157]">
            ✓
          </div>

          <h3 class="mt-4 font-semibold text-slate-900">
            No upcoming tasks
          </h3>

          <p class="mt-2 max-w-sm text-sm text-slate-500">
            You have no pending or in-progress tasks scheduled for today or later.
          </p>
        </div>
      <% end %>
    </div>

    <div class="rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
      <div class="border-b border-stone-200 px-6 py-5">
        <h2 class="text-lg font-semibold text-slate-900">
          Quick actions
        </h2>

        <p class="mt-1 text-sm text-slate-500">
          Common actions for managing your CRM.
        </p>
      </div>

      <div class="space-y-3 p-6">
        <% quick_action_classes = "block w-full rounded-xl border border-stone-200 bg-white/40 px-4 py-3 text-left text-sm font-medium text-slate-700 transition hover:border-slate-300 hover:bg-white hover:text-slate-950" %>

        <%= link_to "Add a new lead",
                    new_lead_path,
                    class: quick_action_classes %>

        <%= link_to "View all leads",
                    leads_path,
                    class: quick_action_classes %>

        <%= link_to "Add a new client",
                    new_client_path,
                    class: quick_action_classes %>

        <%= link_to "View all clients",
                    clients_path,
                    class: quick_action_classes %>

        <%= link_to "View all deals",
                    deals_path,
                    class: quick_action_classes %>

        <%= link_to "Manage tasks",
                    tasks_path,
                    class: quick_action_classes %>
      </div>
    </div>
  </section>
</div>