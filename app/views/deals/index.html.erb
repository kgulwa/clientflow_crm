<div class="space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-[#55705f]">
        Deal management
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-[#27333e]">
        Deals
      </h1>

      <p class="mt-2 text-[#68747e]">
        Track opportunities from prospecting through to won or lost.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Export CSV",
                  deals_path(
                    format: :csv,
                    search: params[:search],
                    stage: params[:stage]
                  ),
                  class: "rounded-lg border border-[#c8cdd2] bg-white/55 px-5 py-3 text-center text-sm font-semibold text-[#465563] transition hover:bg-white" %>

      <%= link_to "Add deal",
                  new_deal_path,
                  class: "rounded-lg bg-[#25313b] px-5 py-3 text-center text-sm font-semibold text-white transition hover:bg-[#17212a]" %>
    </div>
  </section>

  <section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <%= form_with url: deals_path,
                  method: :get,
                  local: true,
                  class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_220px_auto]" do |form| %>
      <div>
        <%= form.label :search,
                       "Search deals",
                       class: "block text-sm font-medium text-[#53606b]" %>

        <%= form.search_field :search,
                              value: params[:search],
                              placeholder: "Deal title or client name",
                              class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
      </div>

      <div>
        <%= form.label :stage,
                       class: "block text-sm font-medium text-[#53606b]" %>

        <%= form.select(
              :stage,
              Deal.stages.keys.map { |stage| [stage.titleize, stage] },
              {
                include_blank: "All stages",
                selected: params[:stage]
              },
              class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]"
            ) %>
      </div>

      <div class="flex items-end gap-3">
        <%= form.submit "Apply filters",
                        class: "cursor-pointer rounded-lg bg-[#25313b] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#17212a]" %>

        <% if params[:search].present? || params[:stage].present? %>
          <%= link_to "Clear",
                      deals_path,
                      class: "rounded-lg border border-[#c8cdd2] bg-white/55 px-5 py-2 text-sm font-semibold text-[#465563] transition hover:bg-white" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-xl border border-[#dedfdf] bg-white/65 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <% if @deals.any? %>
      <div class="border-b border-[#dedfdf] px-6 py-4">
        <p class="text-sm font-medium text-[#53606b]">
          <%= pluralize(@deals.size, "deal") %> on this page
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-[#dedfdf]">
          <thead class="bg-white/35">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Deal
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Client
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Stage
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Value
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Expected close
              </th>

              <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-[#74808b]">
                Actions
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-[#dedfdf]">
            <% @deals.each do |deal| %>
              <tr class="transition hover:bg-white/55">
                <td class="px-6 py-4">
                  <%= link_to deal.title,
                              deal_path(deal),
                              class: "font-semibold text-[#27333e] transition hover:text-[#416550]" %>

                  <p class="mt-1 max-w-sm truncate text-sm text-[#74808b]">
                    <%= deal.description.presence || "No description added" %>
                  </p>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-[#53606b]">
                  <%= deal.client.full_name %>
                </td>

                <td class="whitespace-nowrap px-6 py-4">
                  <% stage_classes = case deal.stage
                                     when "won"
                                       "border border-[#c7d8c9] bg-[#edf4ed] text-[#416550]"
                                     when "lost"
                                       "border border-[#ead1ce] bg-[#f8efed] text-[#9d443d]"
                                     when "negotiation"
                                       "border border-[#d9d3c7] bg-[#f4f1e9] text-[#76674f]"
                                     when "proposal_sent"
                                       "border border-[#cbd6d8] bg-[#edf2f2] text-[#4e686c]"
                                     when "qualified"
                                       "border border-[#ced9d2] bg-[#edf3ef] text-[#526b5b]"
                                     else
                                       "border border-[#e1d7bd] bg-[#f7f3e8] text-[#7b6944]"
                                     end %>

                  <span class="rounded-full px-3 py-1 text-xs font-semibold <%= stage_classes %>">
                    <%= deal.display_stage %>
                  </span>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm font-semibold text-[#27333e]">
                  <%= number_to_currency(
                        deal.value,
                        unit: "R",
                        separator: ".",
                        delimiter: ","
                      ) %>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-[#53606b]">
                  <%= deal.expected_close_date&.strftime("%d %B %Y") || "—" %>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                  <%= link_to "View",
                              deal_path(deal),
                              class: "font-semibold text-[#416550] transition hover:text-[#315542]" %>

                  <%= link_to "Edit",
                              edit_deal_path(deal),
                              class: "ml-4 font-semibold text-[#68747e] transition hover:text-[#27333e]" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= render "shared/pagination", pagy: @pagy %>
    <% elsif params[:search].present? || params[:stage].present? %>
      <div class="flex min-h-80 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#dedfdf] bg-white/45 text-xl font-bold text-[#53606b]">
          ?
        </div>

        <h2 class="mt-4 text-lg font-semibold text-[#27333e]">
          No matching deals
        </h2>

        <p class="mt-2 max-w-md text-sm text-[#68747e]">
          Try changing your search or clearing the filters.
        </p>

        <%= link_to "Clear filters",
                    deals_path,
                    class: "mt-6 rounded-lg border border-[#c8cdd2] bg-white/55 px-5 py-3 text-sm font-semibold text-[#465563] transition hover:bg-white" %>
      </div>
    <% else %>
      <div class="flex min-h-80 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full border border-[#cfdccf] bg-[#eef4ed] text-xl font-bold text-[#416550]">
          D
        </div>

        <h2 class="mt-4 text-lg font-semibold text-[#27333e]">
          No deals yet
        </h2>

        <p class="mt-2 max-w-md text-sm text-[#68747e]">
          Create your first deal to begin tracking opportunities through your
          sales pipeline.
        </p>

        <%= link_to "Add your first deal",
                    new_deal_path,
                    class: "mt-6 rounded-lg bg-[#25313b] px-5 py-3 text-sm font-semibold text-white transition hover:bg-[#17212a]" %>
      </div>
    <% end %>
  </section>
</div>
