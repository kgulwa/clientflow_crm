<div class="mx-auto max-w-3xl space-y-6">
  <section>
    <p class="text-sm font-semibold uppercase tracking-wide text-[#55705f]">
      Deal management
    </p>

    <h1 class="mt-1 text-3xl font-bold tracking-tight text-[#27333e]">
      Add a new deal
    </h1>

    <p class="mt-2 text-[#68747e]">
      Create a new opportunity and connect it to one of your clients.
    </p>
  </section>

  <section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)] sm:p-8">
    <%= render "form", deal: @deal %>
  </section>
</div>
