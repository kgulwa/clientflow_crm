<div class="space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
        Deal details
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
        <%= @deal.title %>
      </h1>

      <p class="mt-2 text-gray-600">
        Opportunity for <%= @deal.client.full_name %>
      </p>
    </div>

    <div class="flex flex-wrap gap-3">
      <%= link_to "Edit deal",
                  edit_deal_path(@deal),
                  class: "rounded-lg border border-gray-300 px-5 py-3 text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= button_to "Delete deal",
                    deal_path(@deal),
                    method: :delete,
                    form: {
                      data: {
                        turbo_confirm: "Are you sure you want to delete this deal?"
                      }
                    },
                    class: "rounded-lg bg-red-600 px-5 py-3 text-sm font-semibold text-white transition hover:bg-red-700" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-lg font-semibold text-gray-900">
        Opportunity details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">
            Client
          </dt>

          <dd class="mt-1 text-base font-semibold text-gray-900">
            <%= @deal.client.full_name %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Stage
          </dt>

          <dd class="mt-1 text-base font-semibold text-gray-900">
            <%= @deal.display_stage %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Value
          </dt>

          <dd class="mt-1 text-base font-semibold text-gray-900">
            <%= number_to_currency(@deal.value, unit: "R", separator: ".", delimiter: ",") %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Expected close date
          </dt>

          <dd class="mt-1 text-base font-semibold text-gray-900">
            <%= @deal.expected_close_date&.strftime("%d %B %Y") || "Not set" %>
          </dd>
        </div>
      </dl>
    </div>

    <aside class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">
        Pipeline
      </h2>

      <p class="mt-2 text-sm text-gray-500">
        Current position in the sales process.
      </p>

      <div class="mt-6 rounded-lg bg-indigo-50 px-4 py-5 text-center">
        <p class="text-sm font-medium text-indigo-700">
          Current stage
        </p>

        <p class="mt-1 text-xl font-bold text-indigo-900">
          <%= @deal.display_stage %>
        </p>
      </div>
    </aside>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">
      Description
    </h2>

    <p class="mt-4 whitespace-pre-wrap text-gray-600">
      <%= @deal.description.presence || "No description has been added for this deal." %>
    </p>
  </section>

  <div>
    <%= link_to "← Back to deals",
                deals_path,
                class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>
  </div>
</div>