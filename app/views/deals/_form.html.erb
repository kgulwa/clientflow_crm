<%= form_with model: deal, class: "space-y-6" do |form| %>
  <% if deal.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-semibold">
        <%= pluralize(deal.errors.count, "error") %>
        prevented this deal from being saved:
      </h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% deal.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_field :title,
                        autofocus: true,
                        required: true,
                        placeholder: "Website redesign opportunity",
                        class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= form.label :client_id,
                   "Client",
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.collection_select(
          :client_id,
          current_user.clients.order(:first_name, :last_name),
          :id,
          :full_name,
          {
            prompt: "Select a client"
          },
          {
            required: true,
            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          }
        ) %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :stage,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.select(
            :stage,
            Deal.stages.keys.map { |stage| [stage.titleize, stage] },
            {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ) %>
    </div>

    <div>
      <%= form.label :value,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.number_field :value,
                            min: 0,
                            step: 0.01,
                            required: true,
                            class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= form.label :expected_close_date,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.date_field :expected_close_date,
                        class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div>
    <%= form.label :description,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_area :description,
                       rows: 6,
                       placeholder: "Add useful details about this opportunity...",
                       class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-gray-200 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
                deal.persisted? ? deal_path(deal) : deals_path,
                class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

    <%= form.submit class: "cursor-pointer rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
  </div>
<% end %>