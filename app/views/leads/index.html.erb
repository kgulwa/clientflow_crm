<div class="space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-500">
        Lead management
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-slate-900">
        Leads
      </h1>

      <p class="mt-2 text-slate-600">
        Track potential customers before they become clients.
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Export CSV",
                  leads_path(
                    format: :csv,
                    search: params[:search],
                    status: params[:status],
                    source: params[:source]
                  ),
                  class: "rounded-xl border border-stone-300 bg-white/60 px-5 py-3 text-center text-sm font-semibold text-slate-700 transition hover:border-slate-400 hover:bg-white hover:text-slate-900" %>

      <%= link_to "Add lead",
                  new_lead_path,
                  class: "rounded-xl bg-slate-800 px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
    </div>
  </section>

  <section class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
    <%= form_with url: leads_path,
                  method: :get,
                  local: true,
                  class: "grid gap-4 lg:grid-cols-[minmax(0,1fr)_220px_220px_auto]" do |form| %>
      <div>
        <%= form.label :search,
                       "Search leads",
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.search_field :search,
                              value: params[:search],
                              placeholder: "Name, company, or email",
                              class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>

      <div>
        <%= form.label :status,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.select(
              :status,
              Lead.statuses.keys.map { |status|
                [status == "new_lead" ? "New" : status.titleize, status]
              },
              {
                include_blank: "All statuses",
                selected: params[:status]
              },
              class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            ) %>
      </div>

      <div>
        <%= form.label :source,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.select(
              :source,
              Lead.sources.keys.map { |source|
                [source == "linkedin" ? "LinkedIn" : source.titleize, source]
              },
              {
                include_blank: "All sources",
                selected: params[:source]
              },
              class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
            ) %>
      </div>

      <div class="flex items-end gap-3">
        <%= form.submit "Apply filters",
                        class: "cursor-pointer rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>

        <% if params[:search].present? || params[:status].present? || params[:source].present? %>
          <%= link_to "Clear",
                      leads_path,
                      class: "rounded-xl border border-stone-300 bg-white/50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-white hover:text-slate-900" %>
        <% end %>
      </div>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-white/70 bg-white/65 shadow-sm backdrop-blur">
    <% if @leads.any? %>
      <div class="border-b border-stone-200 px-6 py-4">
        <p class="text-sm font-medium text-slate-700">
          <%= pluralize(@leads.size, "lead") %> on this page
        </p>
      </div>

      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-stone-200">
          <thead class="bg-white/30">
            <tr>
              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                Lead
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                Company
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                Source
              </th>

              <th class="px-6 py-3 text-left text-xs font-semibold uppercase tracking-wide text-slate-500">
                Status
              </th>

              <th class="px-6 py-3 text-right text-xs font-semibold uppercase tracking-wide text-slate-500">
                Actions
              </th>
            </tr>
          </thead>

          <tbody class="divide-y divide-stone-200 bg-transparent">
            <% @leads.each do |lead| %>
              <tr class="transition hover:bg-white/40">
                <td class="px-6 py-4">
                  <div class="flex items-center gap-3">
                    <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-700">
                      <%= avatar_initials(lead.full_name) %>
                    </div>

                    <div>
                      <%= link_to lead.full_name,
                                  lead_path(lead),
                                  class: "font-semibold text-slate-900 transition hover:text-black" %>

                      <p class="mt-1 text-sm text-slate-500">
                        <%= lead.email %>
                      </p>
                    </div>
                  </div>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                  <%= lead.company_name.presence || "—" %>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-sm text-slate-600">
                  <%= lead.source == "linkedin" ? "LinkedIn" : lead.source.titleize %>
                </td>

                <td class="whitespace-nowrap px-6 py-4">
                  <% status_classes = case lead.status
                                      when "qualified"
                                        "bg-[#e5eee8] text-[#3e7157]"
                                      when "contacted"
                                        "bg-[#e8edf3] text-[#3e5f7d]"
                                      when "lost"
                                        "bg-[#f3e3e0] text-[#9d443d]"
                                      when "converted"
                                        "bg-[#ecebea] text-[#55616c]"
                                      else
                                        "bg-[#f5ead7] text-[#9b661f]"
                                      end %>

                  <span class="rounded-full px-3 py-1 text-xs font-semibold <%= status_classes %>">
                    <%= lead.display_status %>
                  </span>
                </td>

                <td class="whitespace-nowrap px-6 py-4 text-right text-sm">
                  <%= link_to "View",
                              lead_path(lead),
                              class: "font-semibold text-slate-700 transition hover:text-slate-950" %>

                  <%= link_to "Edit",
                              edit_lead_path(lead),
                              class: "ml-4 font-semibold text-slate-500 transition hover:text-slate-900" %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>

      <%= render "shared/pagination", pagy: @pagy %>
    <% elsif params[:search].present? || params[:status].present? || params[:source].present? %>
      <div class="flex min-h-80 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-slate-100 text-xl font-bold text-slate-600">
          ?
        </div>

        <h2 class="mt-4 text-lg font-semibold text-slate-900">
          No matching leads
        </h2>

        <p class="mt-2 max-w-md text-sm text-slate-500">
          Try changing your search or clearing the filters.
        </p>

        <%= link_to "Clear filters",
                    leads_path,
                    class: "mt-6 rounded-xl border border-stone-300 bg-white/50 px-5 py-3 text-sm font-semibold text-slate-700 transition hover:bg-white hover:text-slate-900" %>
      </div>
    <% else %>
      <div class="flex min-h-80 flex-col items-center justify-center px-6 py-12 text-center">
        <div class="flex h-14 w-14 items-center justify-center rounded-full bg-[#f5ead7] text-xl font-bold text-[#9b661f]">
          L
        </div>

        <h2 class="mt-4 text-lg font-semibold text-slate-900">
          No leads yet
        </h2>

        <p class="mt-2 max-w-md text-sm text-slate-500">
          Add your first lead to begin tracking potential customers and
          follow-up opportunities.
        </p>

        <%= link_to "Add your first lead",
                    new_lead_path,
                    class: "mt-6 rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
      </div>
    <% end %>
  </section>
</div>