<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to leads",
                  leads_path,
                  class: "text-sm font-semibold text-[#416550] transition hover:text-[#315542]" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#27333e]">
        <%= @lead.full_name %>
      </h1>

      <p class="mt-2 text-[#68747e]">
        <%= @lead.company_name.presence || "Independent lead" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit lead",
                  edit_lead_path(@lead),
                  class: "rounded-lg border border-[#c8cdd2] bg-white/55 px-5 py-2 text-center text-sm font-semibold text-[#465563] transition hover:bg-white" %>

      <%= link_to "Delete lead",
                  lead_path(@lead),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this lead?"
                  },
                  class: "rounded-lg bg-[#b54b42] px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-[#9d443d]" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)] lg:col-span-2">
      <h2 class="text-lg font-semibold text-[#27333e]">
        Contact details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-[#74808b]">Email</dt>

          <dd class="mt-1 text-[#27333e]">
            <%= mail_to @lead.email, @lead.email %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-[#74808b]">Phone</dt>

          <dd class="mt-1 text-[#27333e]">
            <%= @lead.phone.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-[#74808b]">Company</dt>

          <dd class="mt-1 text-[#27333e]">
            <%= @lead.company_name.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-[#74808b]">Added</dt>

          <dd class="mt-1 text-[#27333e]">
            <%= @lead.created_at.strftime("%B %-d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
      <h2 class="text-lg font-semibold text-[#27333e]">
        Lead details
      </h2>

      <dl class="mt-6 space-y-5">
        <div>
          <dt class="text-sm font-medium text-[#74808b]">
            Current status
          </dt>

          <dd class="mt-2">
            <span class="inline-flex rounded-full border border-[#cfdccf] bg-[#eef4ed] px-3 py-1 text-sm font-semibold text-[#416550]">
              <%= @lead.display_status %>
            </span>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-[#74808b]">
            Source
          </dt>

          <dd class="mt-1 text-[#27333e]">
            <%= @lead.source == "linkedin" ? "LinkedIn" : @lead.source.titleize %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <h2 class="text-lg font-semibold text-[#27333e]">
      Lead notes
    </h2>

    <div class="mt-4 whitespace-pre-wrap text-[#53606b]">
      <%= @lead.notes.presence || "No notes have been added for this lead." %>
    </div>
  </section>
</div>
