<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to leads",
                  leads_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
        <%= @lead.full_name %>
      </h1>

      <p class="mt-2 text-gray-600">
        <%= @lead.company_name.presence || "Independent lead" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit lead",
                  edit_lead_path(@lead),
                  class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= link_to "Delete lead",
                  lead_path(@lead),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this lead?"
                  },
                  class: "rounded-lg bg-red-600 px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-red-700" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-lg font-semibold text-gray-900">
        Contact details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>

          <dd class="mt-1 text-gray-900">
            <%= mail_to @lead.email, @lead.email %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Phone</dt>

          <dd class="mt-1 text-gray-900">
            <%= @lead.phone.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Company</dt>

          <dd class="mt-1 text-gray-900">
            <%= @lead.company_name.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Added</dt>

          <dd class="mt-1 text-gray-900">
            <%= @lead.created_at.strftime("%B %-d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">
        Lead details
      </h2>

      <dl class="mt-6 space-y-5">
        <div>
          <dt class="text-sm font-medium text-gray-500">Current status</dt>

          <dd class="mt-2">
            <span class="inline-flex rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
              <%= @lead.display_status %>
            </span>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Source</dt>

          <dd class="mt-1 text-gray-900">
            <%= @lead.source == "linkedin" ? "LinkedIn" : @lead.source.titleize %>
          </dd>
        </div>
      </dl>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">
      Lead notes
    </h2>

    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= @lead.notes.presence || "No notes have been added for this lead." %>
    </div>
  </section>
</div>