<div class="mx-auto max-w-3xl space-y-6">
  <div>
    <%= link_to "← Back to lead",
                lead_path(@lead),
                class: "text-sm font-semibold text-[#416550] transition hover:text-[#315542]" %>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#27333e]">
      Edit <%= @lead.full_name %>
    </h1>

    <p class="mt-2 text-[#68747e]">
      Update the lead's contact details, source, and current status.
    </p>
  </div>

  <div class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)] sm:p-8">
    <%= render "form", lead: @lead %>
  </div>
</div>
