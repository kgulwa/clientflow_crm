<%= form_with model: lead, class: "space-y-6" do |form| %>
  <% if lead.errors.any? %>
    <div class="rounded-xl border border-[#e5c8c3] bg-[#f7ecea] p-4 text-[#8b3f39]">
      <h2 class="font-semibold">
        <%= pluralize(lead.errors.count, "error") %>
        prevented this lead from being saved:
      </h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% lead.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :first_name,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :first_name,
                          autofocus: true,
                          required: true,
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div>
      <%= form.label :last_name,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :last_name,
                          required: true,
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>
  </div>

  <div>
    <%= form.label :company_name,
                   class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_field :company_name,
                        class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :email,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.email_field :email,
                           required: true,
                           class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div>
      <%= form.label :phone,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.telephone_field :phone,
                               class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :source,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.select(
            :source,
            Lead.sources.keys.map { |source|
              [source == "linkedin" ? "LinkedIn" : source.titleize, source]
            },
            {},
            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
          ) %>
    </div>

    <div>
      <%= form.label :status,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.select(
            :status,
            Lead.statuses.keys.map { |status|
              [status == "new_lead" ? "New" : status.titleize, status]
            },
            {},
            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200"
          ) %>
    </div>
  </div>

  <div>
    <%= form.label :notes,
                   class: "block text-sm font-medium text-slate-700" %>

    <%= form.text_area :notes,
                       rows: 6,
                       placeholder: "Add useful details about this lead...",
                       class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-stone-200 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
                lead.persisted? ? lead_path(lead) : leads_path,
                class: "rounded-xl border border-stone-300 bg-white/50 px-5 py-3 text-center text-sm font-semibold text-slate-700 transition hover:bg-white hover:text-slate-900" %>

    <%= form.submit class: "cursor-pointer rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
  </div>
<% end %>