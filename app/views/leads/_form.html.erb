<%= form_with model: lead, class: "space-y-6" do |form| %>
  <% if lead.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4 text-red-800">
      <h2 class="font-semibold">
        <%= pluralize(lead.errors.count, "error") %>
        prevented this lead from being saved:
      </h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% lead.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :first_name,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :first_name,
                          autofocus: true,
                          required: true,
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= form.label :last_name,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :last_name,
                          required: true,
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div>
    <%= form.label :company_name,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_field :company_name,
                        class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :email,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.email_field :email,
                           required: true,
                           class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>

    <div>
      <%= form.label :phone,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.telephone_field :phone,
                               class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :source,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.select(
            :source,
            Lead.sources.keys.map { |source|
              [source == "linkedin" ? "LinkedIn" : source.titleize, source]
            },
            {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ) %>
    </div>

    <div>
      <%= form.label :status,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.select(
            :status,
            Lead.statuses.keys.map { |status|
              [status == "new_lead" ? "New" : status.titleize, status]
            },
            {},
            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500"
          ) %>
    </div>
  </div>

  <div>
    <%= form.label :notes,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.text_area :notes,
                       rows: 6,
                       placeholder: "Add useful details about this lead...",
                       class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-500" %>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-gray-200 pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
                lead.persisted? ? lead_path(lead) : leads_path,
                class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

    <%= form.submit class: "cursor-pointer rounded-lg bg-indigo-600 px-5 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
  </div>
<% end %>