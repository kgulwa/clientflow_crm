<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to clients",
                  clients_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
        <%= @client.full_name %>
      </h1>

      <p class="mt-2 text-gray-600">
        <%= @client.company_name.presence || "Independent client" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit client",
                  edit_client_path(@client),
                  class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= link_to "Delete client",
                  client_path(@client),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this client?"
                  },
                  class: "rounded-lg bg-red-600 px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-red-700" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-lg font-semibold text-gray-900">Contact details</h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>
          <dd class="mt-1 text-gray-900">
            <%= mail_to @client.email, @client.email %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Phone</dt>
          <dd class="mt-1 text-gray-900">
            <%= @client.phone.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Company</dt>
          <dd class="mt-1 text-gray-900">
            <%= @client.company_name.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Added</dt>
          <dd class="mt-1 text-gray-900">
            <%= @client.created_at.strftime("%B %-d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Relationship</h2>

      <div class="mt-6">
        <p class="text-sm font-medium text-gray-500">Current status</p>

        <span class="mt-2 inline-flex rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
          <%= @client.status.titleize %>
        </span>
      </div>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">General notes</h2>

    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= @client.notes.presence || "No general notes have been added for this client." %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Add client note</h2>

      <%= form_with model: [@client, @note], class: "mt-6 space-y-4" do |form| %>
        <% if @note.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 p-4">
            <h3 class="text-sm font-semibold text-red-800">
              Please fix the following:
            </h3>

            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
              <% @note.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_field :title,
                              class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                              placeholder: "Follow-up call" %>
        </div>

        <div>
          <%= form.label :content,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_area :content,
                             rows: 5,
                             class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                             placeholder: "Add details about the interaction..." %>
        </div>

        <%= form.submit "Add note",
                        class: "w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
      <% end %>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Client note history</h2>

        <p class="mt-1 text-sm text-gray-500">
          Calls, meetings, emails, and follow-up details.
        </p>
      </div>

      <% if @client_notes.any? %>
        <% @client_notes.each do |note| %>
          <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold text-gray-900">
                  <%= note.title %>
                </h3>

                <p class="mt-1 text-sm text-gray-500">
                  <%= note.created_at.strftime("%B %-d, %Y at %-I:%M %p") %>
                </p>
              </div>

              <%= link_to "Delete",
                          client_note_path(@client, note),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure you want to delete this note?"
                          },
                          class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
            </div>

            <div class="mt-4 whitespace-pre-wrap text-gray-700">
              <%= note.content %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
          <p class="text-gray-600">
            No client note history has been added yet.
          </p>
        </div>
      <% end %>
    </div>
  </section>
</div>