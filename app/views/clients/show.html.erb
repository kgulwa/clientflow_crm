<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to clients",
                  clients_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
        <%= @client.full_name %>
      </h1>

      <p class="mt-2 text-gray-600">
        <%= @client.company_name.presence || "Independent client" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit client",
                  edit_client_path(@client),
                  class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= link_to "Delete client",
                  client_path(@client),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this client?"
                  },
                  class: "rounded-lg bg-red-600 px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-red-700" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-lg font-semibold text-gray-900">Contact details</h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">Email</dt>

          <dd class="mt-1 text-gray-900">
            <%= mail_to @client.email, @client.email %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Phone</dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.phone.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Company</dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.company_name.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">Added</dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.created_at.strftime("%B %-d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Relationship</h2>

      <div class="mt-6">
        <p class="text-sm font-medium text-gray-500">Current status</p>

        <span class="mt-2 inline-flex rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
          <%= @client.status.titleize %>
        </span>
      </div>
    </div>
  </section>

  <%= render "clients/tags" %>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div class="flex items-center justify-between">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Contacts</h2>

        <p class="mt-1 text-sm text-gray-500">
          People associated with this client.
        </p>
      </div>

      <%= link_to "Add contact",
                  new_client_contact_path(@client),
                  class: "rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
    </div>

    <% if @client.contacts.any? %>
      <div class="mt-6 divide-y divide-gray-200">
        <% @client.contacts.primary_first.each do |contact| %>
          <div class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between">
            <div>
              <div class="flex flex-wrap items-center gap-2">
                <%= link_to contact.full_name,
                            client_contact_path(@client, contact),
                            class: "font-semibold text-indigo-600 hover:text-indigo-800" %>

                <% if contact.primary_contact? %>
                  <span class="inline-flex rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">
                    Primary
                  </span>
                <% end %>
              </div>

              <p class="mt-1 text-sm text-gray-600">
                <%= contact.job_title.presence || "No job title" %>
              </p>

              <p class="mt-1 text-sm text-gray-500">
                <%= contact.email %>
              </p>
            </div>

            <div class="flex gap-2">
              <%= link_to "View",
                          client_contact_path(@client, contact),
                          class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 hover:bg-gray-100" %>

              <%= link_to "Edit",
                          edit_client_contact_path(@client, contact),
                          class: "rounded-lg border border-indigo-300 px-3 py-2 text-sm font-semibold text-indigo-700 hover:bg-indigo-50" %>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="mt-6 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center">
        <p class="text-gray-600">
          No contacts have been added for this client yet.
        </p>
      </div>
    <% end %>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Client summary</h2>

      <p class="mt-1 text-sm text-gray-500">
        A quick overview of this client's activity.
      </p>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">Open tasks</dt>

        <dd class="mt-2 text-2xl font-bold text-gray-900">
          <%= @client_statistics[:open_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">Completed tasks</dt>

        <dd class="mt-2 text-2xl font-bold text-gray-900">
          <%= @client_statistics[:completed_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">Overdue tasks</dt>

        <dd class="mt-2 text-2xl font-bold text-gray-900">
          <%= @client_statistics[:overdue_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">Total notes</dt>

        <dd class="mt-2 text-2xl font-bold text-gray-900">
          <%= @client_statistics[:total_notes] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">Client since</dt>

        <dd class="mt-2 text-lg font-bold text-gray-900">
          <%= @client.created_at.strftime("%B %Y") %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">Activity timeline</h2>

      <p class="mt-1 text-sm text-gray-500">
        Notes and task activity for this client, ordered from newest to oldest.
      </p>
    </div>

    <% if @activities.any? %>
      <ol class="mt-6 space-y-6">
        <% @activities.each do |activity| %>
          <li class="relative pl-10">
            <span class="absolute left-0 top-1 flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">
              <%= activity[:icon] %>
            </span>

            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
                    <%= activity[:label] %>
                  </p>

                  <p class="mt-1 font-semibold text-gray-900">
                    <%= activity[:title] %>
                  </p>

                  <% if activity[:description].present? %>
                    <p class="mt-1 text-sm text-gray-600">
                      <%= activity[:description] %>
                    </p>
                  <% end %>
                </div>

                <% if activity[:occurred_at].present? %>
                  <time class="shrink-0 text-sm text-gray-500">
                    <%= activity[:occurred_at].strftime("%B %-d, %Y at %-I:%M %p") %>
                  </time>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="mt-6 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center">
        <p class="text-gray-600">
          No activity has been recorded for this client yet.
        </p>
      </div>
    <% end %>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">General notes</h2>

    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= @client.notes.presence || "No general notes have been added for this client." %>
    </div>
  </section>
    <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Add task</h2>

      <%= form_with model: [@client, @task], class: "mt-6 space-y-4" do |form| %>
        <% if @task.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 p-4">
            <h3 class="text-sm font-semibold text-red-800">
              Please fix the following:
            </h3>

            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
              <% @task.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_field :title,
                              class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                              placeholder: "Send proposal" %>
        </div>

        <div>
          <%= form.label :description,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_area :description,
                             rows: 4,
                             class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                             placeholder: "Add any helpful task details..." %>
        </div>

        <div>
          <%= form.label :due_date,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.date_field :due_date,
                              class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>

        <div>
          <%= form.label :priority,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.select :priority,
                          Task.priorities.keys.map { |priority| [priority.titleize, priority] },
                          {},
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500" %>
        </div>

        <%= form.hidden_field :status, value: "pending" %>

        <%= form.submit "Add task",
                        class: "w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
      <% end %>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Client tasks</h2>

        <p class="mt-1 text-sm text-gray-500">
          Track follow-ups, deadlines, and completed work.
        </p>
      </div>

      <% if @tasks.any? %>
        <% @tasks.each do |task| %>
          <% overdue = task.due_date.present? &&
                       task.due_date < Date.current &&
                       !task.completed? %>

          <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
              <div>
                <div class="flex flex-wrap items-center gap-2">
                  <h3 class="font-semibold text-gray-900">
                    <%= task.title %>
                  </h3>

                  <span class="inline-flex rounded-full bg-gray-100 px-2.5 py-1 text-xs font-semibold text-gray-700">
                    <%= task.status.titleize %>
                  </span>

                  <span class="inline-flex rounded-full bg-indigo-50 px-2.5 py-1 text-xs font-semibold text-indigo-700">
                    <%= task.priority.titleize %> priority
                  </span>

                  <% if overdue %>
                    <span class="inline-flex rounded-full bg-red-50 px-2.5 py-1 text-xs font-semibold text-red-700">
                      Overdue
                    </span>
                  <% end %>
                </div>

                <p class="mt-2 text-sm text-gray-500">
                  <% if task.due_date.present? %>
                    Due <%= task.due_date.strftime("%B %-d, %Y") %>
                  <% else %>
                    No due date
                  <% end %>
                </p>
              </div>

              <%= link_to "Delete",
                          client_task_path(@client, task),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure you want to delete this task?"
                          },
                          class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
            </div>

            <% if task.description.present? %>
              <div class="mt-4 whitespace-pre-wrap text-gray-700">
                <%= task.description %>
              </div>
            <% end %>

            <div class="mt-5 flex flex-wrap gap-2">
              <% unless task.pending? %>
                <%= button_to "Mark pending",
                              client_task_path(@client, task),
                              method: :patch,
                              params: {
                                task: {
                                  status: "pending"
                                }
                              },
                              class: "rounded-lg border border-gray-300 px-3 py-2 text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>
              <% end %>

              <% unless task.in_progress? %>
                <%= button_to "Start task",
                              client_task_path(@client, task),
                              method: :patch,
                              params: {
                                task: {
                                  status: "in_progress"
                                }
                              },
                              class: "rounded-lg border border-indigo-300 px-3 py-2 text-sm font-semibold text-indigo-700 transition hover:bg-indigo-50" %>
              <% end %>

              <% unless task.completed? %>
                <%= button_to "Complete task",
                              client_task_path(@client, task),
                              method: :patch,
                              params: {
                                task: {
                                  status: "completed"
                                }
                              },
                              class: "rounded-lg bg-green-600 px-3 py-2 text-sm font-semibold text-white transition hover:bg-green-700" %>
              <% end %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
          <p class="text-gray-600">
            No tasks have been added for this client.
          </p>
        </div>
      <% end %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">Add client note</h2>

      <%= form_with model: [@client, @note], class: "mt-6 space-y-4" do |form| %>
        <% if @note.errors.any? %>
          <div class="rounded-lg border border-red-200 bg-red-50 p-4">
            <h3 class="text-sm font-semibold text-red-800">
              Please fix the following:
            </h3>

            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
              <% @note.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :title,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_field :title,
                              class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                              placeholder: "Follow-up call" %>
        </div>

        <div>
          <%= form.label :content,
                         class: "block text-sm font-medium text-gray-700" %>

          <%= form.text_area :content,
                             rows: 5,
                             class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-indigo-500",
                             placeholder: "Add details about the interaction..." %>
        </div>

        <%= form.submit "Add note",
                        class: "w-full rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
      <% end %>
    </div>

    <div class="space-y-4 lg:col-span-2">
      <div>
        <h2 class="text-lg font-semibold text-gray-900">Client note history</h2>

        <p class="mt-1 text-sm text-gray-500">
          Calls, meetings, emails, and follow-up details.
        </p>
      </div>

      <% if @client_notes.any? %>
        <% @client_notes.each do |note| %>
          <article class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
            <div class="flex items-start justify-between gap-4">
              <div>
                <h3 class="font-semibold text-gray-900">
                  <%= note.title %>
                </h3>

                <p class="mt-1 text-sm text-gray-500">
                  <%= note.created_at.strftime("%B %-d, %Y at %-I:%M %p") %>
                </p>
              </div>

              <%= link_to "Delete",
                          client_note_path(@client, note),
                          data: {
                            turbo_method: :delete,
                            turbo_confirm: "Are you sure you want to delete this note?"
                          },
                          class: "text-sm font-semibold text-red-600 hover:text-red-800" %>
            </div>

            <div class="mt-4 whitespace-pre-wrap text-gray-700">
              <%= note.content %>
            </div>
          </article>
        <% end %>
      <% else %>
        <div class="rounded-xl border border-dashed border-gray-300 bg-white p-8 text-center">
          <p class="text-gray-600">
            No client note history has been added yet.
          </p>
        </div>
      <% end %>
    </div>
  </section>
</div>