<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to clients",
                  clients_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
        <%= @client.full_name %>
      </h1>

      <p class="mt-2 text-gray-600">
        <%= @client.company_name.presence || "Independent client" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit client",
                  edit_client_path(@client),
                  class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= link_to "Delete client",
                  client_path(@client),
                  data: {
                    turbo_method: :delete,
                    turbo_confirm: "Are you sure you want to delete this client?"
                  },
                  class: "rounded-lg bg-red-600 px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-red-700" %>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-3">
    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-2">
      <h2 class="text-lg font-semibold text-gray-900">
        Contact details
      </h2>

      <dl class="mt-6 grid gap-6 sm:grid-cols-2">
        <div>
          <dt class="text-sm font-medium text-gray-500">
            Email
          </dt>

          <dd class="mt-1 text-gray-900">
            <%= mail_to @client.email, @client.email %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Phone
          </dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.phone.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Company
          </dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.company_name.presence || "Not provided" %>
          </dd>
        </div>

        <div>
          <dt class="text-sm font-medium text-gray-500">
            Added
          </dt>

          <dd class="mt-1 text-gray-900">
            <%= @client.created_at.strftime("%B %-d, %Y") %>
          </dd>
        </div>
      </dl>
    </div>

    <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <h2 class="text-lg font-semibold text-gray-900">
        Relationship
      </h2>

      <div class="mt-6">
        <p class="text-sm font-medium text-gray-500">
          Current status
        </p>

        <span class="mt-2 inline-flex rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
          <%= @client.status.titleize %>
        </span>
      </div>
    </div>
  </section>

  <%= render "clients/tags_section",
             client: @client,
             tag: @tag,
             tags: @tags,
             client_tags: @client_tags %>

  <%= render "clients/contacts_section",
             client: @client,
             contact: @client.contacts.new,
             contacts: @contacts,
             editing_contact: @editing_contact %>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">
        Client summary
      </h2>

      <p class="mt-1 text-sm text-gray-500">
        A quick overview of this client's activity.
      </p>
    </div>

    <dl class="mt-6 grid gap-4 sm:grid-cols-2 lg:grid-cols-5">
      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">
          Open tasks
        </dt>

        <dd
          id="open_tasks_count"
          class="mt-2 text-2xl font-bold text-gray-900"
        >
          <%= @client_statistics[:open_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">
          Completed tasks
        </dt>

        <dd
          id="completed_tasks_count"
          class="mt-2 text-2xl font-bold text-gray-900"
        >
          <%= @client_statistics[:completed_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">
          Overdue tasks
        </dt>

        <dd
          id="overdue_tasks_count"
          class="mt-2 text-2xl font-bold text-gray-900"
        >
          <%= @client_statistics[:overdue_tasks] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">
          Total notes
        </dt>

        <dd
          id="total_notes_count"
          class="mt-2 text-2xl font-bold text-gray-900"
        >
          <%= @client_statistics[:total_notes] %>
        </dd>
      </div>

      <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
        <dt class="text-sm font-medium text-gray-500">
          Client since
        </dt>

        <dd class="mt-2 text-lg font-bold text-gray-900">
          <%= @client.created_at.strftime("%B %Y") %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <div>
      <h2 class="text-lg font-semibold text-gray-900">
        Activity timeline
      </h2>

      <p class="mt-1 text-sm text-gray-500">
        Notes and task activity for this client, ordered from newest to oldest.
      </p>
    </div>

    <% if @activities.any? %>
      <ol class="mt-6 space-y-6">
        <% @activities.each do |activity| %>
          <li class="relative pl-10">
            <span class="absolute left-0 top-1 flex h-7 w-7 items-center justify-center rounded-full bg-indigo-100 text-xs font-bold text-indigo-700">
              <%= activity[:icon] %>
            </span>

            <div class="rounded-xl border border-gray-200 bg-gray-50 p-4">
              <div class="flex flex-col justify-between gap-2 sm:flex-row sm:items-start">
                <div>
                  <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
                    <%= activity[:label] %>
                  </p>

                  <p class="mt-1 font-semibold text-gray-900">
                    <%= activity[:title] %>
                  </p>

                  <% if activity[:description].present? %>
                    <p class="mt-1 text-sm text-gray-600">
                      <%= activity[:description] %>
                    </p>
                  <% end %>
                </div>

                <% if activity[:occurred_at].present? %>
                  <time class="shrink-0 text-sm text-gray-500">
                    <%= activity[:occurred_at].strftime(
                          "%B %-d, %Y at %-I:%M %p"
                        ) %>
                  </time>
                <% end %>
              </div>
            </div>
          </li>
        <% end %>
      </ol>
    <% else %>
      <div class="mt-6 rounded-xl border border-dashed border-gray-300 bg-gray-50 p-8 text-center">
        <p class="text-gray-600">
          No activity has been recorded for this client yet.
        </p>
      </div>
    <% end %>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">
      General notes
    </h2>

    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= @client.notes.presence ||
          "No general notes have been added for this client." %>
    </div>
  </section>

  <%= render "clients/tasks_section",
             client: @client,
             task: @task,
             tasks: @tasks %>

  <%= render "clients/notes_section",
             client: @client,
             note: @note,
             client_notes: @client_notes %>
</div>