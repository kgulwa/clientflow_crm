<section
  id="notes_section"
  class="grid gap-6 lg:grid-cols-3"
>
  <div class="rounded-2xl border border-white/70 bg-white/65 p-6 shadow-sm backdrop-blur">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-500">
        New note
      </p>

      <h2 class="mt-1 text-lg font-semibold text-slate-900">
        Add client note
      </h2>

      <p class="mt-1 text-sm leading-6 text-slate-500">
        Record an interaction, update, or useful client detail.
      </p>
    </div>

    <%= form_with model: [client, note],
                  class: "mt-6 space-y-4" do |form| %>
      <% if note.errors.any? %>
        <div class="rounded-xl border border-[#e5c8c3] bg-[#f7ecea] p-4">
          <h3 class="text-sm font-semibold text-[#8b3f39]">
            Please fix the following:
          </h3>

          <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[#9a4d46]">
            <% note.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <div>
        <%= form.label :title,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_field :title,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200",
                            placeholder: "Follow-up call" %>
      </div>

      <div>
        <%= form.label :content,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_area :content,
                           rows: 5,
                           class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200",
                           placeholder: "Add details about the interaction..." %>
      </div>

      <%= form.submit "Add note",
                      class: "w-full cursor-pointer rounded-xl bg-slate-800 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
    <% end %>
  </div>

  <div class="space-y-4 lg:col-span-2">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-stone-500">
        Notes
      </p>

      <h2 class="mt-1 text-lg font-semibold text-slate-900">
        Client note history
      </h2>

      <p class="mt-1 text-sm text-slate-500">
        Calls, meetings, emails, and follow-up details.
      </p>
    </div>

    <% if client_notes.any? %>
      <div class="space-y-4">
        <%= render partial: "notes/note",
                   collection: client_notes,
                   locals: { client: client } %>
      </div>
    <% else %>
      <div class="rounded-2xl border border-dashed border-stone-300 bg-white/40 p-8 text-center">
        <p class="text-slate-600">
          No client note history has been added yet.
        </p>
      </div>
    <% end %>
  </div>
</section>