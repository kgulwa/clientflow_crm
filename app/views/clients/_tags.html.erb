<section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
  <div>
    <h2 class="text-lg font-semibold text-[#27333e]">Tags</h2>

    <p class="mt-1 text-sm text-[#68747e]">
      Organize this client with reusable labels.
    </p>
  </div>

  <div class="mt-6">
    <% if @client_tags.any? %>
      <div class="flex flex-wrap gap-2">
        <% @client_tags.each do |client_tag| %>
          <div class="inline-flex items-center gap-2 rounded-full border border-[#cfdccf] bg-[#eef4ed] px-3 py-1">
            <span class="text-sm font-semibold text-[#416550]">
              <%= client_tag.tag.name %>
            </span>

            <%= button_to "×",
                          client_client_tag_path(@client, client_tag),
                          method: :delete,
                          form: {
                            data: {
                              turbo_confirm: "Remove this tag from the client?"
                            }
                          },
                          class: "border-0 bg-transparent p-0 text-sm font-bold text-[#9d443d] transition hover:text-[#693733]",
                          aria: {
                            label: "Remove #{client_tag.tag.name} tag"
                          } %>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="rounded-xl border border-dashed border-[#d5d5d2] bg-white/35 p-6 text-center">
        <p class="text-sm text-[#68747e]">
          No tags have been assigned to this client yet.
        </p>
      </div>
    <% end %>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-2">
    <div class="rounded-xl border border-[#dedfdf] bg-white/35 p-5">
      <h3 class="font-semibold text-[#27333e]">
        Assign an existing tag
      </h3>

      <p class="mt-1 text-sm text-[#68747e]">
        Select one of your existing tags for this client.
      </p>

      <% available_tags = @tags.reject { |tag| @client_tags.any? { |client_tag| client_tag.tag_id == tag.id } } %>

      <% if available_tags.any? %>
        <%= form_with scope: :client_tag,
                      url: client_client_tags_path(@client),
                      method: :post,
                      class: "mt-4 space-y-4" do |form| %>
          <div>
            <%= form.label :tag_id,
                           "Tag",
                           class: "block text-sm font-medium text-[#53606b]" %>

            <%= form.select :tag_id,
                            available_tags.map { |tag| [tag.name, tag.id] },
                            {
                              prompt: "Choose a tag"
                            },
                            class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]",
                            required: true %>
          </div>

          <%= form.submit "Assign tag",
                          class: "w-full cursor-pointer rounded-lg border border-[#cad9ce] bg-[#eef4ed] px-4 py-2 text-sm font-semibold text-[#416550] transition hover:bg-[#dfe9e2]" %>
        <% end %>
      <% else %>
        <p class="mt-4 text-sm text-[#68747e]">
          All existing tags have already been assigned to this client.
        </p>
      <% end %>
    </div>

    <div class="rounded-xl border border-[#dedfdf] bg-white/35 p-5">
      <h3 class="font-semibold text-[#27333e]">
        Create a new tag
      </h3>

      <p class="mt-1 text-sm text-[#68747e]">
        Create a reusable tag and assign it immediately.
      </p>

      <%= form_with model: [@client, @tag],
                    class: "mt-4 space-y-4" do |form| %>
        <% if @tag.errors.any? %>
          <div class="rounded-lg border border-[#ead1ce] bg-[#f8efed] p-4">
            <h4 class="text-sm font-semibold text-[#9d443d]">
              Please fix the following:
            </h4>

            <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[#8a4b46]">
              <% @tag.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div>
          <%= form.label :name,
                         class: "block text-sm font-medium text-[#53606b]" %>

          <%= form.text_field :name,
                              class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]",
                              placeholder: "VIP",
                              required: true %>
        </div>

        <div>
          <%= form.label :color,
                         class: "block text-sm font-medium text-[#53606b]" %>

          <%= form.select :color,
                          [
                            ["Indigo", "indigo"],
                            ["Blue", "blue"],
                            ["Green", "green"],
                            ["Yellow", "yellow"],
                            ["Orange", "orange"],
                            ["Red", "red"],
                            ["Pink", "pink"],
                            ["Purple", "purple"],
                            ["Gray", "gray"]
                          ],
                          {
                            selected: @tag.color.presence || Tag::DEFAULT_COLOR
                          },
                          class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
        </div>

        <%= form.submit "Create and assign tag",
                        class: "w-full cursor-pointer rounded-lg bg-[#25313b] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#17212a]" %>
      <% end %>
    </div>
  </div>
</section>
