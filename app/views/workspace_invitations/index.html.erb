<div class="mx-auto max-w-6xl space-y-8">
  <section class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
    <div>
      <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
        Workspace
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-gray-900">
        Team
      </h1>

      <p class="mt-2 max-w-2xl text-sm leading-6 text-gray-600">
        Manage the people who belong to
        <span class="font-semibold text-gray-900">
          <%= @workspace.name %>
        </span>
        and invite teammates to collaborate in ClientFlow.
      </p>
    </div>
  </section>

  <section class="grid gap-6 lg:grid-cols-[minmax(0,1fr)_minmax(320px,0.7fr)]">
    <div class="rounded-2xl border border-gray-200 bg-white shadow-sm">
      <div class="border-b border-gray-200 px-6 py-5">
        <div class="flex items-center justify-between gap-4">
          <div>
            <h2 class="text-lg font-semibold text-gray-900">
              Workspace members
            </h2>

            <p class="mt-1 text-sm text-gray-500">
              Everyone who currently has access to this workspace.
            </p>
          </div>

          <span class="rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
            <%= @workspace_users.count %>
          </span>
        </div>
      </div>

      <div class="divide-y divide-gray-100">
        <% @workspace_users.each do |user| %>
          <div class="flex items-center justify-between gap-4 px-6 py-5">
            <div class="flex min-w-0 items-center gap-4">
              <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-700">
                <%= avatar_initials(user.full_name) %>
              </div>

              <div class="min-w-0">
                <p class="truncate font-semibold text-gray-900">
                  <%= user.full_name %>
                </p>

                <p class="truncate text-sm text-gray-500">
                  <%= user.email %>
                </p>
              </div>
            </div>

            <span class="shrink-0 rounded-full bg-gray-100 px-3 py-1 text-xs font-semibold text-gray-700">
              <%= user.role.titleize %>
            </span>
          </div>
        <% end %>
      </div>
    </div>

    <div class="space-y-6">
      <section class="rounded-2xl border border-gray-200 bg-white p-6 shadow-sm">
        <div>
          <h2 class="text-lg font-semibold text-gray-900">
            Invite teammate
          </h2>

          <p class="mt-1 text-sm leading-6 text-gray-500">
            Send an invitation to someone you want to join this workspace.
          </p>
        </div>

        <%= form_with(
              model: @workspace_invitation,
              url: workspace_invitations_path,
              class: "mt-6 space-y-4"
            ) do |form| %>

          <% if @workspace_invitation.errors.any? %>
            <div class="rounded-xl border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-800">
              <p class="font-semibold">
                <%= pluralize(
                      @workspace_invitation.errors.count,
                      "error"
                    ) %>
                prevented this invitation from being created:
              </p>

              <ul class="mt-2 list-disc space-y-1 pl-5">
                <% @workspace_invitation.errors.full_messages.each do |message| %>
                  <li><%= message %></li>
                <% end %>
              </ul>
            </div>
          <% end %>

          <div>
            <%= form.label :email,
                           "Email address",
                           class: "block text-sm font-semibold text-gray-700" %>

            <%= form.email_field :email,
                                 autofocus: true,
                                 autocomplete: "email",
                                 placeholder: "teammate@example.com",
                                 required: true,
                                 class: "mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
          </div>

          <%= form.submit "Send invitation",
                          class: "w-full cursor-pointer rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition duration-200 hover:scale-[1.01] hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
        <% end %>
      </section>

      <section class="rounded-2xl border border-gray-200 bg-white shadow-sm">
        <div class="border-b border-gray-200 px-6 py-5">
          <div class="flex items-center justify-between gap-4">
            <div>
              <h2 class="text-lg font-semibold text-gray-900">
                Pending invitations
              </h2>

              <p class="mt-1 text-sm text-gray-500">
                Invitations that have not been accepted yet.
              </p>
            </div>

            <span class="rounded-full bg-amber-50 px-3 py-1 text-sm font-semibold text-amber-700">
              <%= @workspace_invitations.pending.count %>
            </span>
          </div>
        </div>

        <% pending_invitations = @workspace_invitations.pending %>

        <% if pending_invitations.any? %>
          <div class="divide-y divide-gray-100">
            <% pending_invitations.each do |invitation| %>
              <div class="flex items-center justify-between gap-4 px-6 py-5">
                <div class="min-w-0">
                  <p class="truncate font-semibold text-gray-900">
                    <%= invitation.email %>
                  </p>

                  <p class="mt-1 text-xs text-gray-500">
                    Invited by
                    <%= invitation.invited_by.full_name %>
                  </p>
                </div>

                <%= button_to "Remove",
                              workspace_invitation_path(invitation),
                              method: :delete,
                              form: {
                                data: {
                                  turbo_confirm: "Remove this invitation?"
                                }
                              },
                              class: "shrink-0 rounded-lg border border-red-200 px-3 py-2 text-xs font-semibold text-red-700 transition hover:bg-red-50" %>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="px-6 py-8 text-center">
            <p class="text-sm font-medium text-gray-700">
              No pending invitations
            </p>

            <p class="mt-1 text-sm text-gray-500">
              New invitations will appear here.
            </p>
          </div>
        <% end %>
      </section>
    </div>
  </section>
</div>