<div class="mx-auto max-w-xl">
  <div class="rounded-2xl border border-[#dedfdf] bg-white/65 p-8 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <p class="text-sm font-semibold uppercase tracking-wide text-[#55705f]">
      Workspace invitation
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-[#27333e]">
      Join <%= @workspace_invitation.workspace.name %>
    </h1>

    <p class="mt-4 text-sm leading-6 text-[#68747e]">
      <strong class="text-[#27333e]">
        <%= @workspace_invitation.invited_by.full_name %>
      </strong>
      invited
      <strong class="text-[#27333e]">
        <%= @workspace_invitation.email %>
      </strong>
      to join this ClientFlow workspace.
    </p>

    <% if user_signed_in? %>
      <div class="mt-6 rounded-xl border border-[#e1d7bd] bg-[#f7f3e8] p-4">
        <p class="text-sm font-semibold text-[#6f6044]">
          You're currently signed in as
          <%= current_user.email %>.
        </p>

        <p class="mt-2 text-sm leading-6 text-[#7b6944]">
          This invitation is for
          <strong><%= @workspace_invitation.email %></strong>.
          Sign out first, then continue with the invitation to create the
          invited account.
        </p>
      </div>

      <div class="mt-8">
        <%= link_to "Sign out to continue",
                    destroy_user_session_path,
                    data: {
                      turbo_method: :delete
                    },
                    class: "block w-full rounded-xl bg-[#25313b] px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-[#17212a]" %>
      </div>
    <% else %>
      <p class="mt-3 text-sm leading-6 text-[#68747e]">
        Create your ClientFlow account to accept the invitation and start
        collaborating with the team.
      </p>

      <div class="mt-8">
        <%= link_to "Create account and join workspace",
                    new_user_registration_path(
                      invitation_token: @workspace_invitation.token
                    ),
                    class: "block w-full rounded-xl bg-[#25313b] px-5 py-3 text-center text-sm font-semibold text-white shadow-sm transition hover:bg-[#17212a]" %>
      </div>
    <% end %>

    <p class="mt-5 text-center text-xs text-[#74808b]">
      This invitation is intended for
      <%= @workspace_invitation.email %>.
    </p>
  </div>
</div>
