<div class="mx-auto max-w-xl">
  <div class="rounded-2xl border border-gray-200 bg-white p-8 shadow-sm">
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
      Workspace invitation
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
      Join <%= @workspace_invitation.workspace.name %>
    </h1>

    <p class="mt-4 text-sm leading-6 text-gray-600">
      <strong><%= @workspace_invitation.invited_by.full_name %></strong>
      invited
      <strong><%= @workspace_invitation.email %></strong>
      to join this ClientFlow workspace.
    </p>

    <% if user_signed_in? %>
      <div class="mt-6 rounded-xl border border-amber-200 bg-amber-50 p-4">
        <p class="text-sm font-semibold text-amber-900">
          You're currently signed in as
          <%= current_user.email %>.
        </p>

        <p class="mt-2 text-sm leading-6 text-amber-800">
          This invitation is for
          <strong><%= @workspace_invitation.email %></strong>.
          Sign out first, then continue with the invitation to create the
          invited account.
        </p>
      </div>

      <div class="mt-8">
        <%= link_to "Sign out to continue",
                    destroy_user_session_path,
                    data: {
                      turbo_method: :delete
                    },
                    class: "block w-full rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:from-indigo-700 hover:to-violet-700" %>
      </div>
    <% else %>
      <p class="mt-3 text-sm leading-6 text-gray-600">
        Create your ClientFlow account to accept the invitation and start
        collaborating with the team.
      </p>

      <div class="mt-8">
        <%= link_to "Create account and join workspace",
                    new_user_registration_path(
                      invitation_token: @workspace_invitation.token
                    ),
                    class: "block w-full rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-center text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition hover:from-indigo-700 hover:to-violet-700" %>
      </div>
    <% end %>

    <p class="mt-5 text-center text-xs text-gray-500">
      This invitation is intended for
      <%= @workspace_invitation.email %>.
    </p>
  </div>
</div>