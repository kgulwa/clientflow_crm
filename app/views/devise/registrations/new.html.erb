<div class="w-full">
  <div class="mb-8 lg:hidden">
    <div class="flex items-center gap-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white shadow-lg shadow-indigo-100">
        CF
      </div>

      <div>
        <p class="text-lg font-bold tracking-tight text-gray-900">
          ClientFlow
        </p>

        <p class="text-sm text-gray-500">
          Customer relationship management
        </p>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
      Get started
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
      Create your account
    </h1>

    <p class="mt-3 text-sm leading-6 text-gray-600">
      Start managing clients, leads, deals, tasks, and follow-ups from one
      focused workspace.
    </p>
  </div>

  <%= form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: {
          class: "mt-8 space-y-5"
        }
      ) do |form| %>
    <%= render "devise/shared/error_messages",
               resource: resource %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :first_name,
                       class: "block text-sm font-semibold text-gray-700" %>

        <%= form.text_field :first_name,
                            autofocus: true,
                            autocomplete: "given-name",
                            placeholder: "First name",
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
      </div>

      <div>
        <%= form.label :last_name,
                       class: "block text-sm font-semibold text-gray-700" %>

        <%= form.text_field :last_name,
                            autocomplete: "family-name",
                            placeholder: "Last name",
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
      </div>
    </div>

    <div>
      <%= form.label :email,
                     class: "block text-sm font-semibold text-gray-700" %>

      <%= form.email_field :email,
                           autocomplete: "email",
                           placeholder: "you@example.com",
                           required: true,
                           class: "mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
    </div>

    <div>
      <div class="flex items-center justify-between gap-4">
        <%= form.label :password,
                       class: "block text-sm font-semibold text-gray-700" %>
        <% if @minimum_password_length %>
          <span class="text-xs text-gray-500">
            <%= @minimum_password_length %> characters minimum
          </span>
        <% end %>
      </div>
      <div
        class="relative mt-2"
        data-controller="password-visibility"
      >
        <%= form.password_field :password,
                                autocomplete: "new-password",
                                placeholder: "Create a password",
                                required: true,
                                data: {
                                  password_visibility_target: "input"
                                },
                                class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        <button
          type="button"
          aria-label="Show password"
          aria-pressed="false"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          class="absolute inset-y-0 right-0 flex items-center px-4 text-gray-400 transition hover:text-indigo-600 focus:outline-none focus:text-indigo-600"
        >
          <span data-password-visibility-target="showIcon">👁</span>
          <span
            data-password-visibility-target="hideIcon"
            class="hidden"
          >
            🙈
          </span>
        </button>
      </div>
    </div>

    <div>
      <%= form.label :password_confirmation,
                     "Confirm password",
                     class: "block text-sm font-semibold text-gray-700" %>
      <div
        class="relative mt-2"
        data-controller="password-visibility"
      >
        <%= form.password_field :password_confirmation,
                                autocomplete: "new-password",
                                placeholder: "Enter the password again",
                                required: true,
                                data: {
                                  password_visibility_target: "input"
                                },
                                class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
        <button
          type="button"
          aria-label="Show password"
          aria-pressed="false"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          class="absolute inset-y-0 right-0 flex items-center px-4 text-gray-400 transition hover:text-indigo-600 focus:outline-none focus:text-indigo-600"
        >
          <span data-password-visibility-target="showIcon">👁</span>
          <span
            data-password-visibility-target="hideIcon"
            class="hidden"
          >
            🙈
          </span>
        </button>
      </div>
    </div>

    <%= form.submit "Create account",
                    class: "w-full cursor-pointer rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition duration-200 hover:scale-[1.01] hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2" %>
  <% end %>

  <p class="mt-5 text-center text-xs leading-5 text-gray-500">
    By creating an account, you agree to keep your login details secure.
  </p>

  <div class="mt-8 border-t border-gray-200 pt-6 text-center">
    <p class="text-sm text-gray-600">
      Already have an account?

      <%= link_to "Sign in",
                  new_session_path(resource_name),
                  class: "font-semibold text-indigo-600 transition hover:text-indigo-800" %>
    </p>
  </div>
</div>