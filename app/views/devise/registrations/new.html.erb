<div class="w-full">
  <div class="mb-8 lg:hidden">
    <div class="flex items-center gap-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl border border-stone-300 bg-stone-100 text-sm font-bold text-slate-800 shadow-sm">
        CF
      </div>

      <div>
        <p class="text-lg font-bold tracking-tight text-slate-900">
          ClientFlow
        </p>

        <p class="text-sm text-slate-500">
          Customer relationship management
        </p>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-semibold uppercase tracking-[0.16em] text-stone-500">
      Get started
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-slate-900">
      Create your account
    </h1>

    <p class="mt-3 text-sm leading-6 text-slate-600">
      Start managing clients, leads, deals, tasks, and follow-ups from one
      focused workspace.
    </p>
  </div>

  <%= form_for(
        resource,
        as: resource_name,
        url: registration_path(resource_name),
        html: {
          class: "mt-8 space-y-5",
          data: {
            controller: "submit-button",
            action: "turbo:submit-start->submit-button#submit turbo:submit-end->submit-button#reset",
            submit_button_loading_text_value: "Creating account..."
          }
        }
      ) do |form| %>

    <% if @workspace_invitation.present? %>
      <%= hidden_field_tag :invitation_token,
                           @workspace_invitation.token %>
    <% end %>

    <%= render "devise/shared/error_messages",
               resource: resource %>

    <div class="grid gap-5 sm:grid-cols-2">
      <div>
        <%= form.label :first_name,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.text_field :first_name,
                            autofocus: true,
                            autocomplete: "given-name",
                            placeholder: "First name",
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>

      <div>
        <%= form.label :last_name,
                       class: "block text-sm font-semibold text-slate-700" %>

        <%= form.text_field :last_name,
                            autocomplete: "family-name",
                            placeholder: "Last name",
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>
    </div>

    <div>
      <%= form.label :email,
                     class: "block text-sm font-semibold text-slate-700" %>

      <%= form.email_field :email,
                           autocomplete: "email",
                           placeholder: "you@example.com",
                           required: true,
                           class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div>
      <div class="flex items-center justify-between gap-4">
        <%= form.label :password,
                       class: "block text-sm font-semibold text-slate-700" %>

        <% if @minimum_password_length %>
          <span class="text-xs text-slate-500">
            <%= @minimum_password_length %> characters minimum
          </span>
        <% end %>
      </div>

      <div
        class="relative mt-2"
        data-controller="password-visibility"
      >
        <%= form.password_field :password,
                                autocomplete: "new-password",
                                placeholder: "Create a password",
                                required: true,
                                data: {
                                  password_visibility_target: "input"
                                },
                                class: "block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 pr-12 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>

        <button
          type="button"
          aria-label="Show password"
          aria-pressed="false"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          class="absolute inset-y-0 right-0 flex items-center px-4 text-slate-400 transition hover:text-slate-700 focus:outline-none focus:text-slate-700"
        >
          <svg
            data-password-visibility-target="showIcon"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
            />

            <circle cx="12" cy="12" r="3" />
          </svg>

          <svg
            data-password-visibility-target="hideIcon"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m3 3 18 18"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.6 10.6a2 2 0 0 0 2.8 2.8"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.9 5.5A9.5 9.5 0 0 1 12 5.25C18 5.25 21.75 12 21.75 12a17.7 17.7 0 0 1-2.7 3.7"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.2 6.2C3.7 8.2 2.25 12 2.25 12S6 18.75 12 18.75c1 0 2-.2 2.9-.5"
            />
          </svg>
        </button>
      </div>
    </div>

    <div>
      <%= form.label :password_confirmation,
                     "Confirm password",
                     class: "block text-sm font-semibold text-slate-700" %>

      <div
        class="relative mt-2"
        data-controller="password-visibility"
      >
        <%= form.password_field :password_confirmation,
                                autocomplete: "new-password",
                                placeholder: "Enter the password again",
                                required: true,
                                data: {
                                  password_visibility_target: "input"
                                },
                                class: "block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 pr-12 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>

        <button
          type="button"
          aria-label="Show password"
          aria-pressed="false"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          class="absolute inset-y-0 right-0 flex items-center px-4 text-slate-400 transition hover:text-slate-700 focus:outline-none focus:text-slate-700"
        >
          <svg
            data-password-visibility-target="showIcon"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
            />

            <circle cx="12" cy="12" r="3" />
          </svg>

          <svg
            data-password-visibility-target="hideIcon"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m3 3 18 18"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.6 10.6a2 2 0 0 0 2.8 2.8"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.9 5.5A9.5 9.5 0 0 1 12 5.25C18 5.25 21.75 12 21.75 12a17.7 17.7 0 0 1-2.7 3.7"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.2 6.2C3.7 8.2 2.25 12 2.25 12S6 18.75 12 18.75c1 0 2-.2 2.9-.5"
            />
          </svg>
        </button>
      </div>
    </div>

    <%= form.submit "Create account",
                    data: {
                      submit_button_target: "button"
                    },
                    class: "w-full cursor-pointer rounded-xl bg-slate-800 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-slate-300/40 transition duration-200 hover:bg-slate-900 focus:outline-none focus:ring-2 focus:ring-slate-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-70" %>
  <% end %>

  <p class="mt-5 text-center text-xs leading-5 text-slate-500">
    By creating an account, you agree to keep your login details secure.
  </p>

  <div class="mt-8 border-t border-stone-200 pt-6 text-center">
    <p class="text-sm text-slate-600">
      Already have an account?

      <%= link_to "Sign in",
                  new_session_path(resource_name),
                  class: "font-semibold text-slate-800 transition hover:text-slate-950" %>
    </p>
  </div>
</div>