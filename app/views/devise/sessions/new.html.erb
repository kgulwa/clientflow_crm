<div class="w-full">
  <div class="mb-8 lg:hidden">
    <div class="flex items-center gap-3">
      <div class="flex h-12 w-12 items-center justify-center rounded-2xl bg-gradient-to-br from-indigo-500 to-violet-600 text-sm font-bold text-white shadow-lg shadow-indigo-100">
        CF
      </div>

      <div>
        <p class="text-lg font-bold tracking-tight text-gray-900">
          ClientFlow
        </p>

        <p class="text-sm text-gray-500">
          Customer relationship management
        </p>
      </div>
    </div>
  </div>

  <div>
    <p class="text-sm font-semibold uppercase tracking-wide text-indigo-600">
      Welcome back
    </p>

    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900">
      Sign in to your account
    </h1>

    <p class="mt-3 text-sm leading-6 text-gray-600">
      Access your clients, leads, deals, tasks and notes.
    </p>
  </div>

  <%= form_for(
        resource,
        as: resource_name,
        url: session_path(resource_name),
        html: {
          class: "mt-8 space-y-5",
          data: {
            controller: "submit-button",
            action: "turbo:submit-start->submit-button#submit turbo:submit-end->submit-button#reset",
            submit_button_loading_text_value: "Signing in..."
          }
        }
      ) do |form| %>

    <%= render "devise/shared/error_messages",
               resource: resource %>

    <div>
      <%= form.label :email,
                     class: "block text-sm font-semibold text-gray-700" %>

      <%= form.email_field :email,
                           autofocus: true,
                           autocomplete: "email",
                           placeholder: "you@example.com",
                           class: "mt-2 block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>
    </div>

    <div>
      <div class="flex items-center justify-between gap-4">
        <%= form.label :password,
                       class: "block text-sm font-semibold text-gray-700" %>

        <% if devise_mapping.recoverable? %>
          <%= link_to "Forgot password?",
                      new_password_path(resource_name),
                      class: "text-sm font-semibold text-indigo-600 transition hover:text-indigo-800" %>
        <% end %>
      </div>

      <div
        class="relative mt-2"
        data-controller="password-visibility"
      >
        <%= form.password_field :password,
                                autocomplete: "current-password",
                                placeholder: "Enter your password",
                                data: {
                                  password_visibility_target: "input"
                                },
                                class: "block w-full rounded-xl border border-gray-300 bg-white px-4 py-3 pr-12 text-sm text-gray-900 shadow-sm outline-none transition placeholder:text-gray-400 focus:border-indigo-500 focus:ring-2 focus:ring-indigo-100" %>

        <button
          type="button"
          aria-label="Show password"
          aria-pressed="false"
          data-action="password-visibility#toggle"
          data-password-visibility-target="button"
          class="absolute inset-y-0 right-0 flex items-center px-4 text-gray-400 transition hover:text-indigo-600 focus:outline-none focus:text-indigo-600"
        >
          <svg
            data-password-visibility-target="showIcon"
            class="h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M2.25 12s3.75-6.75 9.75-6.75S21.75 12 21.75 12 18 18.75 12 18.75 2.25 12 2.25 12Z"
            />

            <circle
              cx="12"
              cy="12"
              r="3"
            />
          </svg>

          <svg
            data-password-visibility-target="hideIcon"
            class="hidden h-5 w-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="m3 3 18 18"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M10.6 10.6a2 2 0 0 0 2.8 2.8"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M9.9 5.5A9.5 9.5 0 0 1 12 5.25C18 5.25 21.75 12 21.75 12a17.7 17.7 0 0 1-2.7 3.7"
            />

            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6.2 6.2C3.7 8.2 2.25 12 2.25 12S6 18.75 12 18.75c1 0 2-.2 2.9-.5"
            />
          </svg>
        </button>
      </div>
    </div>

    <% if devise_mapping.rememberable? %>
      <div class="flex items-center gap-3">
        <%= form.check_box :remember_me,
                           class: "h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>

        <%= form.label :remember_me,
                       "Keep me signed in",
                       class: "text-sm text-gray-600" %>
      </div>
    <% end %>

    <%= form.submit "Sign in",
                    data: {
                      submit_button_target: "button"
                    },
                    class: "w-full cursor-pointer rounded-xl bg-gradient-to-r from-indigo-600 to-violet-600 px-5 py-3 text-sm font-semibold text-white shadow-lg shadow-indigo-200 transition duration-200 hover:scale-[1.01] hover:from-indigo-700 hover:to-violet-700 focus:outline-none focus:ring-2 focus:ring-indigo-500 focus:ring-offset-2 disabled:hover:scale-100" %>

  <% end %>

  <p class="mt-5 text-center text-xs text-gray-500">
    Secure authentication powered by Devise.
  </p>

  <% if devise_mapping.registerable? %>
    <p class="mt-8 text-center text-sm text-gray-600">
      Don’t have an account?

      <%= link_to "Create one",
                  new_registration_path(resource_name),
                  class: "font-semibold text-indigo-600 transition hover:text-indigo-800" %>
    </p>
  <% end %>
</div>