<%= form_with model: [client, contact],
              class: "space-y-4" do |form| %>
  <% if contact.errors.any? %>
    <div class="rounded-lg border border-red-200 bg-red-50 p-4">
      <h3 class="text-sm font-semibold text-red-800">
        Please fix the following:
      </h3>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :first_name,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :first_name,
                          required: true,
                          placeholder: "First name",
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
    </div>

    <div>
      <%= form.label :last_name,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :last_name,
                          required: true,
                          placeholder: "Last name",
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
    </div>
  </div>

  <div>
    <%= form.label :email,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.email_field :email,
                         required: true,
                         placeholder: "contact@example.com",
                         class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
  </div>

  <div>
    <%= form.label :phone,
                   class: "block text-sm font-medium text-gray-700" %>

    <%= form.telephone_field :phone,
                             placeholder: "+27 82 555 0102",
                             class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :job_title,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :job_title,
                          placeholder: "Procurement Manager",
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
    </div>

    <div>
      <%= form.label :department,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_field :department,
                          placeholder: "Procurement",
                          class: "mt-1 block w-full rounded-lg border border-gray-300 px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
    </div>
  </div>

  <div class="rounded-lg border border-gray-200 bg-white p-4">
    <div class="flex items-start gap-3">
      <%= form.check_box :primary_contact,
                         class: "mt-1 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>

      <div>
        <%= form.label :primary_contact,
                       "Set as primary contact",
                       class: "text-sm font-semibold text-gray-900" %>

        <p class="mt-1 text-xs leading-5 text-gray-500">
          Primary contacts appear first in the client’s contact list.
        </p>
      </div>
    </div>
  </div>

  <%= form.submit "Save contact",
                  class: "w-full cursor-pointer rounded-lg bg-indigo-600 px-4 py-2.5 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
<% end %>