<%= form_with model: [client, contact],
              class: "space-y-4" do |form| %>
  <% if contact.errors.any? %>
    <div class="rounded-xl border border-[#e5c8c3] bg-[#f7ecea] p-4">
      <h3 class="text-sm font-semibold text-[#8b3f39]">
        Please fix the following:
      </h3>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[#9a4d46]">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :first_name,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :first_name,
                          required: true,
                          placeholder: "First name",
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div>
      <%= form.label :last_name,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :last_name,
                          required: true,
                          placeholder: "Last name",
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>
  </div>

  <div>
    <%= form.label :email,
                   class: "block text-sm font-medium text-slate-700" %>

    <%= form.email_field :email,
                         required: true,
                         placeholder: "contact@example.com",
                         class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
  </div>

  <div>
    <%= form.label :phone,
                   class: "block text-sm font-medium text-slate-700" %>

    <%= form.telephone_field :phone,
                             placeholder: "+27 82 555 0102",
                             class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <%= form.label :job_title,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :job_title,
                          placeholder: "Procurement Manager",
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div>
      <%= form.label :department,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_field :department,
                          placeholder: "Procurement",
                          class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>
  </div>

  <div class="rounded-xl border border-stone-200 bg-white/40 p-4">
    <div class="flex items-start gap-3">
      <%= form.check_box :primary_contact,
                         class: "mt-1 h-4 w-4 rounded border-stone-300 text-slate-800 focus:ring-slate-400" %>

      <div>
        <%= form.label :primary_contact,
                       "Set as primary contact",
                       class: "text-sm font-semibold text-slate-900" %>

        <p class="mt-1 text-xs leading-5 text-slate-500">
          Primary contacts appear first in the client’s contact list.
        </p>
      </div>
    </div>
  </div>

  <%= form.submit "Save contact",
                  class: "w-full cursor-pointer rounded-xl bg-slate-800 px-4 py-3 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
<% end %>