<% if turbo_frame_request? %>
  <%= turbo_frame_tag @contact do %>
    <%= render "contacts/inline_edit_form",
               client: @client,
               contact: @contact %>
  <% end %>
<% else %>
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <%= link_to "← Back to contact",
                  client_contact_path(@client, @contact),
                  class: "text-sm font-semibold text-[#416550] transition hover:text-[#315542]" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#27333e]">
        Edit contact
      </h1>

      <p class="mt-2 text-[#68747e]">
        Update the contact details for <%= @contact.full_name %>.
      </p>
    </div>

    <section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
      <%= render "form",
                 client: @client,
                 contact: @contact %>
    </section>
  </div>
<% end %>
