<% if turbo_frame_request? %>
  <%= turbo_frame_tag @contact do %>
    <%= render "contacts/inline_edit_form",
               client: @client,
               contact: @contact %>
  <% end %>
<% else %>
  <div class="mx-auto max-w-3xl">
    <div class="mb-6">
      <%= link_to "← Back to contact",
                  client_contact_path(@client, @contact),
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <h1 class="mt-4 text-3xl font-bold tracking-tight text-gray-900">
        Edit contact
      </h1>

      <p class="mt-2 text-gray-600">
        Update the contact details for <%= @contact.full_name %>.
      </p>
    </div>

    <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
      <%= render "form",
                 client: @client,
                 contact: @contact %>
    </section>
  </div>
<% end %>