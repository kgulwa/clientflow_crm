<div class="mx-auto max-w-4xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-start">
    <div>
      <%= link_to "← Back to #{@client.full_name}",
                  client_path(@client, anchor: "contacts_section"),
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-800" %>

      <div class="mt-4 flex flex-wrap items-center gap-3">
        <h1 class="text-3xl font-bold tracking-tight text-gray-900">
          <%= @contact.full_name %>
        </h1>

        <% if @contact.primary_contact? %>
          <span class="inline-flex rounded-full bg-indigo-50 px-3 py-1 text-sm font-semibold text-indigo-700">
            Primary contact
          </span>
        <% end %>
      </div>

      <p class="mt-2 text-gray-600">
        <%= @contact.job_title.presence || "No job title provided" %>
      </p>
    </div>

    <div class="flex flex-col gap-3 sm:flex-row">
      <%= link_to "Edit contact",
                  client_path(
                    @client,
                    edit_contact: @contact.id,
                    anchor: "contacts_section"
                  ),
                  class: "rounded-lg border border-gray-300 px-5 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= button_to "Delete contact",
                    client_contact_path(@client, @contact),
                    method: :delete,
                    params: {
                      return_to_client: true
                    },
                    form: {
                      data: {
                        turbo: false
                      }
                    },
                    data: {
                      turbo_confirm: "Are you sure you want to delete this contact?"
                    },
                    class: "w-full rounded-lg bg-red-600 px-5 py-2 text-center text-sm font-semibold text-white transition hover:bg-red-700 sm:w-auto" %>
    </div>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">
      Contact details
    </h2>

    <dl class="mt-6 grid gap-6 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-medium text-gray-500">
          Email
        </dt>

        <dd class="mt-1 text-gray-900">
          <%= mail_to @contact.email, @contact.email %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">
          Phone
        </dt>

        <dd class="mt-1 text-gray-900">
          <%= @contact.phone.presence || "Not provided" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">
          Job title
        </dt>

        <dd class="mt-1 text-gray-900">
          <%= @contact.job_title.presence || "Not provided" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">
          Department
        </dt>

        <dd class="mt-1 text-gray-900">
          <%= @contact.department.presence || "Not provided" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">
          Client
        </dt>

        <dd class="mt-1">
          <%= link_to @client.company_name.presence || @client.full_name,
                      client_path(@client, anchor: "contacts_section"),
                      class: "font-semibold text-indigo-600 hover:text-indigo-800" %>
        </dd>
      </div>

      <div>
        <dt class="text-sm font-medium text-gray-500">
          Added
        </dt>

        <dd class="mt-1 text-gray-900">
          <%= @contact.created_at.strftime("%B %-d, %Y") %>
        </dd>
      </div>
    </dl>
  </section>

  <section class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
    <h2 class="text-lg font-semibold text-gray-900">
      Notes
    </h2>

    <div class="mt-4 whitespace-pre-wrap text-gray-700">
      <%= @contact.notes.presence ||
          "No notes have been added for this contact." %>
    </div>
  </section>
</div>