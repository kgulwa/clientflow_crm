<article class="my-5 rounded-2xl border border-stone-200 bg-white/45 p-5">
  <div class="mb-5">
    <p class="text-xs font-semibold uppercase tracking-[0.14em] text-stone-500">
      Editing contact
    </p>

    <h3 class="mt-1 font-semibold text-slate-900">
      <%= contact.full_name %>
    </h3>
  </div>

  <%= form_with model: [client, contact],
                class: "space-y-4" do |form| %>
    <% if contact.errors.any? %>
      <div class="rounded-xl border border-[#e5c8c3] bg-[#f7ecea] p-4">
        <h4 class="text-sm font-semibold text-[#8b3f39]">
          Please fix the following:
        </h4>

        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-[#9a4d46]">
          <% contact.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :first_name,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_field :first_name,
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>

      <div>
        <%= form.label :last_name,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_field :last_name,
                            required: true,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :email,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.email_field :email,
                             required: true,
                             class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>

      <div>
        <%= form.label :phone,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.telephone_field :phone,
                                 class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :job_title,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_field :job_title,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>

      <div>
        <%= form.label :department,
                       class: "block text-sm font-medium text-slate-700" %>

        <%= form.text_field :department,
                            class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
      </div>
    </div>

    <div>
      <%= form.label :notes,
                     class: "block text-sm font-medium text-slate-700" %>

      <%= form.text_area :notes,
                         rows: 3,
                         class: "mt-2 block w-full rounded-xl border border-stone-300 bg-white/90 px-4 py-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-slate-500 focus:ring-2 focus:ring-slate-200" %>
    </div>

    <div class="rounded-xl border border-stone-200 bg-white/50 p-4">
      <div class="flex items-start gap-3">
        <%= form.check_box :primary_contact,
                           class: "mt-1 h-4 w-4 rounded border-stone-300 text-slate-800 focus:ring-slate-400" %>

        <div>
          <%= form.label :primary_contact,
                         "Set as primary contact",
                         class: "text-sm font-semibold text-slate-900" %>

          <p class="mt-1 text-xs text-slate-500">
            Primary contacts appear first in the contact list.
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-stone-200 pt-4 sm:flex-row sm:justify-end">
      <%= link_to "Cancel",
                  client_path(client, anchor: "contacts_section"),
                  data: {
                    turbo_frame: "_top"
                  },
                  class: "rounded-xl border border-stone-300 bg-white/60 px-4 py-2.5 text-center text-sm font-semibold text-slate-700 transition hover:bg-white hover:text-slate-900" %>

      <%= form.submit "Save changes",
                      class: "cursor-pointer rounded-xl bg-slate-800 px-4 py-2.5 text-sm font-semibold text-white shadow-sm transition hover:bg-slate-900" %>
    </div>
  <% end %>
</article>