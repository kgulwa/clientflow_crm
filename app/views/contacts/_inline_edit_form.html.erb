<article class="my-5 rounded-xl border border-indigo-200 bg-indigo-50/40 p-5">
  <div class="mb-5">
    <p class="text-xs font-semibold uppercase tracking-wide text-indigo-600">
      Editing contact
    </p>

    <h3 class="mt-1 font-semibold text-gray-900">
      <%= contact.full_name %>
    </h3>
  </div>

  <%= form_with model: [client, contact],
                class: "space-y-4" do |form| %>
    <% if contact.errors.any? %>
      <div class="rounded-lg border border-red-200 bg-red-50 p-4">
        <h4 class="text-sm font-semibold text-red-800">
          Please fix the following:
        </h4>

        <ul class="mt-2 list-disc space-y-1 pl-5 text-sm text-red-700">
          <% contact.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :first_name,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :first_name,
                            required: true,
                            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>

      <div>
        <%= form.label :last_name,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :last_name,
                            required: true,
                            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :email,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.email_field :email,
                             required: true,
                             class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>

      <div>
        <%= form.label :phone,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.telephone_field :phone,
                                 class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>
    </div>

    <div class="grid gap-4 sm:grid-cols-2">
      <div>
        <%= form.label :job_title,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :job_title,
                            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>

      <div>
        <%= form.label :department,
                       class: "block text-sm font-medium text-gray-700" %>

        <%= form.text_field :department,
                            class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
      </div>
    </div>

    <div>
      <%= form.label :notes,
                     class: "block text-sm font-medium text-gray-700" %>

      <%= form.text_area :notes,
                         rows: 3,
                         class: "mt-1 block w-full rounded-lg border border-gray-300 bg-white px-3 py-2 text-sm shadow-sm focus:border-indigo-500 focus:outline-none focus:ring-2 focus:ring-indigo-100" %>
    </div>

    <div class="rounded-lg border border-gray-200 bg-white p-4">
      <div class="flex items-start gap-3">
        <%= form.check_box :primary_contact,
                           class: "mt-1 h-4 w-4 rounded border-gray-300 text-indigo-600 focus:ring-indigo-500" %>

        <div>
          <%= form.label :primary_contact,
                         "Set as primary contact",
                         class: "text-sm font-semibold text-gray-900" %>

          <p class="mt-1 text-xs text-gray-500">
            Primary contacts appear first in the contact list.
          </p>
        </div>
      </div>
    </div>

    <div class="flex flex-col-reverse gap-3 border-t border-indigo-100 pt-4 sm:flex-row sm:justify-end">
      <%= link_to "Cancel",
                  client_path(client, anchor: "contacts_section"),
                  data: {
                    turbo_frame: "_top"
                  },
                  class: "rounded-lg border border-gray-300 bg-white px-4 py-2 text-center text-sm font-semibold text-gray-700 transition hover:bg-gray-100" %>

      <%= form.submit "Save changes",
                      class: "cursor-pointer rounded-lg bg-indigo-600 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-700" %>
    </div>
  <% end %>
</article>