<div class="mx-auto max-w-3xl">
  <div class="mb-6">
    <%= link_to "← Back to #{@client.full_name}",
                client_path(@client),
                class: "text-sm font-semibold text-[#416550] transition hover:text-[#315542]" %>

    <h1 class="mt-4 text-3xl font-bold tracking-tight text-[#27333e]">
      Add contact
    </h1>

    <p class="mt-2 text-[#68747e]">
      Add a new contact person for <%= @client.company_name.presence || @client.full_name %>.
    </p>
  </div>

  <section class="rounded-xl border border-[#dedfdf] bg-white/65 p-6 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <%= render "contacts/form",
               client: @client,
               contact: @contact %>
  </section>
</div>
