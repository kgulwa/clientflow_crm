<%= turbo_frame_tag contact do %>
  <article
    class="flex flex-col gap-4 py-5 sm:flex-row sm:items-center sm:justify-between"
  >
    <div class="flex min-w-0 items-center gap-3">
      <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full bg-slate-100 text-sm font-semibold text-slate-700">
        <%= avatar_initials(contact.full_name) %>
      </div>

      <div class="min-w-0">
        <div class="flex flex-wrap items-center gap-2">
          <%= link_to contact.full_name,
                      client_contact_path(client, contact),
                      data: { turbo_frame: "_top" },
                      class: "font-semibold text-slate-900 transition hover:text-black" %>

          <% if contact.primary_contact? %>
            <span class="inline-flex rounded-full bg-[#e8e5df] px-2.5 py-1 text-xs font-semibold text-[#625b51]">
              Primary
            </span>
          <% end %>
        </div>

        <p class="mt-1 text-sm text-slate-600">
          <%= contact.job_title.presence || "No job title" %>
        </p>

        <p class="mt-1 truncate text-sm text-slate-500">
          <%= contact.email %>
        </p>
      </div>
    </div>

    <div class="flex shrink-0 flex-wrap gap-2">
      <%= link_to "View",
                  client_contact_path(client, contact),
                  data: { turbo_frame: "_top" },
                  class: "rounded-xl border border-stone-300 bg-white/50 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-white hover:text-slate-900" %>

      <%= link_to "Edit",
                  edit_client_contact_path(client, contact),
                  data: { turbo_frame: dom_id(contact) },
                  class: "rounded-xl border border-slate-300 bg-slate-100/60 px-3 py-2 text-sm font-semibold text-slate-700 transition hover:bg-slate-100 hover:text-slate-950" %>

      <%= button_to "Delete",
                    client_contact_path(client, contact),
                    method: :delete,
                    form: {
                      class: "inline",
                      data: {
                        turbo_confirm: "Are you sure you want to delete this contact?"
                      }
                    },
                    class: "rounded-xl border border-[#dfc2bd] bg-[#f5e7e4] px-3 py-2 text-sm font-semibold text-[#8b3f39] transition hover:bg-[#efd8d4]" %>
    </div>
  </article>
<% end %>