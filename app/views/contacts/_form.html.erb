<%= form_with model: [client, contact], class: "space-y-6" do |form| %>
  <% if contact.errors.any? %>
    <div class="rounded-lg border border-[#ead1ce] bg-[#f8efed] p-4 text-[#8a4b46]">
      <h2 class="font-semibold">
        <%= pluralize(contact.errors.count, "error") %>
        prevented this contact from being saved:
      </h2>

      <ul class="mt-2 list-disc space-y-1 pl-5 text-sm">
        <% contact.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :first_name,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.text_field :first_name,
                          autofocus: true,
                          required: true,
                          class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>

    <div>
      <%= form.label :last_name,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.text_field :last_name,
                          required: true,
                          class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :job_title,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.text_field :job_title,
                          placeholder: "Procurement Manager",
                          class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>

    <div>
      <%= form.label :department,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.text_field :department,
                          placeholder: "Procurement",
                          class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :email,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.email_field :email,
                           required: true,
                           placeholder: "contact@example.com",
                           class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>

    <div>
      <%= form.label :phone,
                     class: "block text-sm font-medium text-[#53606b]" %>

      <%= form.telephone_field :phone,
                               placeholder: "+27 82 555 0102",
                               class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
    </div>
  </div>

  <div class="rounded-lg border border-[#dedfdf] bg-white/35 p-4">
    <div class="flex items-start gap-3">
      <%= form.check_box :primary_contact,
                         class: "mt-1 h-4 w-4 rounded border-[#c8cdd2] text-[#416550] focus:ring-[#488267]" %>

      <div>
        <%= form.label :primary_contact,
                       "Set as primary contact",
                       class: "font-medium text-[#27333e]" %>

        <p class="mt-1 text-sm text-[#68747e]">
          Primary contacts will appear first on the client page.
        </p>
      </div>
    </div>
  </div>

  <div>
    <%= form.label :notes,
                   class: "block text-sm font-medium text-[#53606b]" %>

    <%= form.text_area :notes,
                       rows: 6,
                       placeholder: "Add useful details about this contact...",
                       class: "mt-1 block w-full rounded-lg border border-[#c8cdd2] bg-white/70 px-3 py-2 text-[#27333e] shadow-sm outline-none transition placeholder:text-[#8a949d] focus:border-[#488267] focus:ring-2 focus:ring-[#dce8dc]" %>
  </div>

  <div class="flex flex-col-reverse gap-3 border-t border-[#dedfdf] pt-6 sm:flex-row sm:justify-end">
    <%= link_to "Cancel",
                contact.persisted? ? client_contact_path(client, contact) : client_path(client),
                class: "rounded-lg border border-[#c8cdd2] bg-white/55 px-5 py-2 text-center text-sm font-semibold text-[#465563] transition hover:bg-white" %>

    <%= form.submit class: "cursor-pointer rounded-lg bg-[#25313b] px-5 py-2 text-sm font-semibold text-white transition hover:bg-[#17212a]" %>
  </div>
<% end %>
