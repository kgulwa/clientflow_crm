<div class="mx-auto max-w-5xl space-y-6">
  <section class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
    <div>
      <p class="text-sm font-semibold uppercase tracking-[0.14em] text-[#55705f]">
        Activity
      </p>

      <h1 class="mt-1 text-3xl font-bold tracking-tight text-[#27333e]">
        Notifications
      </h1>

      <p class="mt-2 text-sm text-[#68747e]">
        Task assignments and important workspace updates.
      </p>
    </div>

    <% if @unread_count.positive? %>
      <%= button_to "Mark all as read",
                    read_all_notifications_path,
                    method: :patch,
                    class: "rounded-xl border border-[#c8cdd2] bg-white/55 px-4 py-2.5 text-sm font-semibold text-[#465563] transition hover:bg-white" %>
    <% end %>
  </section>

  <section class="overflow-hidden rounded-2xl border border-[#dedfdf] bg-white/65 shadow-[0_12px_35px_rgba(39,48,58,0.05)]">
    <div class="border-b border-[#dedfdf] px-6 py-5">
      <div class="flex items-center justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-[#27333e]">
            Recent activity
          </h2>

          <p class="mt-1 text-sm text-[#68747e]">
            Newest notifications appear first.
          </p>
        </div>

        <span class="rounded-full border border-[#cfdccf] bg-[#eef4ed] px-3 py-1 text-sm font-semibold text-[#416550]">
          <%= @unread_count %> unread
        </span>
      </div>
    </div>

    <% if @notifications.any? %>
      <div class="divide-y divide-[#dedfdf]">
        <% @notifications.each do |notification| %>
          <div
            class="<%= notification.read? ? 'bg-white/20' : 'bg-[#eef4ed]/45' %> px-6 py-5 transition"
          >
            <div class="flex flex-col gap-4 sm:flex-row sm:items-start sm:justify-between">
              <div class="flex min-w-0 gap-4">
                <div class="flex h-10 w-10 shrink-0 items-center justify-center rounded-full border border-[#cfdccf] bg-white/70 text-sm font-semibold text-[#416550]">
                  <%= avatar_initials(notification.actor.full_name) %>
                </div>

                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <p class="font-semibold text-[#27333e]">
                      <%= notification.message %>
                    </p>

                    <% unless notification.read? %>
                      <span class="h-2 w-2 rounded-full bg-[#55705f]"></span>
                    <% end %>
                  </div>

                  <p class="mt-1 text-sm text-[#68747e]">
                    <%= notification.task.client.full_name %>
                  </p>

                  <p class="mt-2 text-xs text-[#8a949d]">
                    <%= time_ago_in_words(notification.created_at) %> ago
                  </p>
                </div>
              </div>

              <div class="shrink-0">
                <% if notification.read? %>
                  <%= link_to "View task",
                              client_path(
                                notification.task.client,
                                anchor: "tasks_section"
                              ),
                              class: "text-sm font-semibold text-[#416550] transition hover:text-[#315542]" %>
                <% else %>
                  <%= button_to "View task",
                                read_notification_path(notification),
                                method: :patch,
                                class: "rounded-xl bg-[#25313b] px-4 py-2 text-sm font-semibold text-white transition hover:bg-[#17212a]" %>
                <% end %>
              </div>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <div class="px-6 py-16 text-center">
        <div class="mx-auto flex h-12 w-12 items-center justify-center rounded-full border border-[#dedfdf] bg-white/45 text-[#68747e]">
          <svg class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 17H9m8-6a5 5 0 1 0-10 0c0 5-2 6-2 6h14s-2-1-2-6ZM10 21h4" />
          </svg>
        </div>

        <h2 class="mt-4 text-lg font-semibold text-[#27333e]">
          No notifications yet
        </h2>

        <p class="mx-auto mt-2 max-w-md text-sm text-[#68747e]">
          Task assignments and other workspace activity will appear here.
        </p>
      </div>
    <% end %>
  </section>
</div>